+			u32 value;
+
+			if (shape->typed_mask & BIT(word)) {
+				reg = shape->pair_registers[word / 2];
+				if (becore_mcsc_dma_value(&becore->chain,
+							  &becore->scaled,
+							  typed_count, reg,
+							  transport,
+							  becore->votf_trs_token,
+							  &value))
+					return -EINVAL;
+				put_unaligned_le32(value, payload + word * 4);
+				typed_count++;
