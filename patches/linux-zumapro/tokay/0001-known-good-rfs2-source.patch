+		.offset = offsetof(struct exynos_ispfe_stats_buffer, motion),
+		.size = sizeof(struct exynos_ispfe_stats_motion),
+		.flag = EXYNOS_ISPFE_STATS_MOTION,
+		.written = ispfe_stats_motion_written,
