+#define S2MPG15_IRQ_OCP_B5S_MASK	BIT(4)
+#define S2MPG15_IRQ_OCP_B6S_MASK	BIT(5)
+#define S2MPG15_IRQ_OCP_B7S_MASK	BIT(6)
