+		for (i = 0; i < BECORE_C2SERV_LINK_PLANES; i++)
+			seq_printf(s,
+				   "  tws%u            %s, dout %#x, rcv %#x, enable %u, limit %u, dest %#07x, token %u, busy %u, fullness %u\n",
+				   i, becore_c2serv_conn_name(link->tws[i].conn),
