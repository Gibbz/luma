+	BECORE_SHARPEN_RANGE(0x5834, 0x583c), \
+	BECORE_SHARPEN_RANGE(0x5844, 0x584c), \
+	BECORE_SHARPEN_RANGE(0x5854, 0x585c), \
+	BECORE_SHARPEN_RANGE(0x5864, 0x586c), \
+	BECORE_SHARPEN_RANGE(0x5888, 0x58b0), \
+	BECORE_SHARPEN_RANGE(0x5900, 0x5900), \
+	BECORE_SHARPEN_RANGE(0x590c, 0x592c), \
+	BECORE_SHARPEN_RANGE(0x5934, 0x594c), \
