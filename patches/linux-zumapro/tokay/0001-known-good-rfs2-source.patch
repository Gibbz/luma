+++ b/drivers/media/platform/samsung/exynos-becore/exynos-becore-sharpen.h
@@ -0,0 +1,1022 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * SHARPENHANCER's float-to-register encode.
+ *
+ * Generated by tools/camera-sharpener-encode.py --c-header; do not edit.
+ *
+ * Each entry says where one value from struct exynos_becore_params_sharpen
+ * lands: which register, which bits of it, and the range the vendor's own
+ * translator clamps it to.  The scale each value is sent at is in the UAPI
+ * header beside the member, because that is where userspace reads it; it is
+ * repeated in the comments here so that the two can be compared.
+ *
+ * `constant` is what `lyric::TranslateYuvSharpEnhancer` deposits in a register
+ * regardless of the tuning, so a parameter set of all zeros encodes to exactly
+ * these constants -- which is what the driver writes underneath a block that
+ * has sent nothing.
+ */
+
+#ifndef __EXYNOS_BECORE_SHARPEN_H
+#define __EXYNOS_BECORE_SHARPEN_H
+
+/**
+ * struct becore_sharpen_field - One value's place in one register
+ * @offset: byte offset of the value in struct exynos_becore_params_sharpen
+ * @min: the smallest value the vendor's translator will encode
+ * @max: the largest
+ * @shift: the bit the field starts at
+ * @width: how wide it is; a field whose @min is negative is two's complement
+ */
+struct becore_sharpen_field {
+	u32 offset;
+	s32 min;
+	s32 max;
+	u8 shift;
+	u8 width;
+};
+
+/**
+ * struct becore_sharpen_reg - One register of the block's tuning
+ * @offset: the register, from BECORE_YUVP_PHYS_BASE
+ * @constant: the bits the translator sets whatever the tuning says
+ * @first: where this register's fields start in becore_sharpen_fields[]
+ * @count: how many it has
+ */
+struct becore_sharpen_reg {
+	u16 offset;
+	u32 constant;
+	u16 first;
+	u8 count;
+};
+
+#define BECORE_SHARPEN_REGS		145
+#define BECORE_SHARPEN_FIELDS		344
+#define BECORE_SHARPEN_VALUES		242
+
+/*
+ * The block is a flat sequence of __s32 behind its header, with no padding
+ * anywhere in it -- which is what lets a payload be written by anything that
+ * can count, and what lets the offsets below be generated from the header's
+ * own member order.  A member added to one and not the other, or a type that
+ * brought alignment with it, stops compiling here rather than in a picture.
+ */
+static_assert(sizeof(struct exynos_becore_params_sharpen) ==
+	      sizeof(struct v4l2_isp_params_block_header) +
+	      BECORE_SHARPEN_VALUES * sizeof(__s32));
+
+#define BECORE_SHARPEN_AT(member)	\
+	offsetof(struct exynos_becore_params_sharpen, member)
+
+static const struct becore_sharpen_field becore_sharpen_fields[] = {
+	/* +0x5004 control [0] x1 */
+	{ BECORE_SHARPEN_AT(enable_low_power), 0, 1, 0, 1 },
+	/* +0x515c texture_index_0 [0] x1 */
+	{ BECORE_SHARPEN_AT(enable_texture_index), 0, 1, 0, 1 },
+	/* +0x5174 edge_index [0] x1 */
+	{ BECORE_SHARPEN_AT(enable_edge_index), 0, 1, 0, 1 },
+	/* +0x5174 edge_index [8] x128 */
+	{ BECORE_SHARPEN_AT(edge_index_dir_multiplier), 0, 255, 8, 8 },
