+static int becore_querycap(struct file *file, void *priv,
+			   struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, "exynos-becore", sizeof(cap->driver));
+	strscpy(cap->card, "zumapro BE-core MCSC NV21", sizeof(cap->card));
+
+	return 0;
+}
