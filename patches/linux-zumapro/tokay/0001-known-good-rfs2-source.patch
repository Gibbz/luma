+			if (shape->generated_mask & BIT(word)) {
+				if (becore_shape_register(shape, word, &reg) ||
+				    becore_generated_value(becore, BECORE_MCSC, reg,
+							   &value))
+					return -EINVAL;
+				put_unaligned_le32(value, payload + word * 4);
+				generated_count++;
+				continue;
+			}
+
+			if (!(shape->address_mask & BIT(word)))
+				continue;
