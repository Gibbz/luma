@@ -0,0 +1,204 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * BYR_DNS's float-to-register encode.
+ *
+ * Generated by tools/camera-byrdns-encode.py --c-header; do not edit.
+ *
+ * Each entry says where one value from struct exynos_becore_params_byr_dns lands:
+ * which register, which bits of it, and the range the vendor's own translator
+ * clamps it to.  The scale each value is sent at is in the UAPI header beside
+ * the member, because that is where userspace reads it.
+ *
+ * `constant` is what `lyric::TranslateByrDns` deposits in a register whatever
+ * the tuning says, so a parameter set of all zeros encodes to exactly these
+ * constants -- which, because the block's `enable` reaches its register
+ * inverted, is the denoiser bypassed.
+ */
+
+#ifndef __EXYNOS_BECORE_BYRDNS_H
+#define __EXYNOS_BECORE_BYRDNS_H
+
+/* The value reaches the register inverted: the block's own bypass bit. */
+#define BECORE_BYR_DNS_FIELD_INVERT		BIT(0)
+
+/*
+ * The value is a white-balance gain and a fixed point away from the register.
+ * Red and blue take their own gain; green takes the mean of the two green
+ * gains, which is what the vendor's translator takes and is unity only while
+ * an AWB normalises green.  The fixed point is the same for all three, so they
+ * share one path and only the gain differs.
+ */
+#define BECORE_BYR_DNS_FIELD_RED		BIT(1)
+#define BECORE_BYR_DNS_FIELD_GREEN		BIT(2)
+#define BECORE_BYR_DNS_FIELD_BLUE		BIT(3)
+
+/**
+ * struct becore_byr_dns_field - One value's place in one register
+ * @offset: byte offset of the value in struct exynos_becore_params_byr_dns
+ * @min: the smallest value the vendor's translator will encode
+ * @max: the largest
+ * @shift: the bit the field starts at
+ * @width: how wide it is
+ * @flags: %BECORE_BYR_DNS_FIELD_INVERT and the two balance flags, or zero
+ */
+struct becore_byr_dns_field {
+	u32 offset;
+	s32 min;
+	s32 max;
+	u8 shift;
+	u8 width;
+	u8 flags;
+};
+
+/**
+ * struct becore_byr_dns_reg - One register of the block's tuning
+ * @offset: the register, from BECORE_RGBP_PHYS_BASE
+ * @constant: the bits the translator sets whatever the tuning says
+ * @first: where this register's fields start in becore_byr_dns_fields[]
+ * @count: how many it has
+ */
+struct becore_byr_dns_reg {
+	u16 offset;
+	u32 constant;
+	u16 first;
+	u8 count;
+};
+
+#define BECORE_BYR_DNS_REGS		19
+#define BECORE_BYR_DNS_FIELDS		35
+#define BECORE_BYR_DNS_VALUES		36
+
+/*
+ * The block is a flat sequence of __s32 behind its header, with no padding
+ * anywhere in it, which is what lets the offsets below be generated from the
+ * header's own member order.  A member added to one and not the other, or a
+ * type that brought alignment with it, stops compiling here.
+ */
+static_assert(sizeof(struct exynos_becore_params_byr_dns) ==
+	      sizeof(struct v4l2_isp_params_block_header) +
+	      BECORE_BYR_DNS_VALUES * sizeof(__s32));
+
+#define BECORE_BYR_DNS_AT(member)	\
+	offsetof(struct exynos_becore_params_byr_dns, member)
+
+static const struct becore_byr_dns_field becore_byr_dns_fields[] = {
+	/* +0x3100 bypass [0] x1 */
+	{ BECORE_BYR_DNS_AT(enable), 0, 1, 0, 1, BECORE_BYR_DNS_FIELD_INVERT },
+	/* +0x3104 controls [10] x1 */
+	{ BECORE_BYR_DNS_AT(enable_low_power), 0, 1, 10, 1, 0 },
+	/* +0x3120 std_lut_y_g [0] x4096 */
+	{ BECORE_BYR_DNS_AT(std_lut_y_g[0]), 0, 4095, 0, 12, 0 },
