+/**
+ * struct exynos_ispfe_stats_ae_region - One region of the exposure grid
+ *
+ * @sum: Sums of the accepted samples, in R, Gr, Gb and B order
+ * @usable_count: Per colour, samples that were neither dark nor saturated
