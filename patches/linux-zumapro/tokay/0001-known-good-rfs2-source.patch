+++ b/drivers/net/wwan/s5xxx_modem_test.c
@@ -0,0 +1,413 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Real driver functions, fake registers; no PCI/CP hardware is touched. */
+#include <kunit/test.h>
+#include <kunit/device.h>
+#include <linux/logic_iomem.h>
+#include <linux/vmalloc.h>
+
+#define TEST_IO_SIZE SZ_8M
+#define TEST_DOORBELL SZ_4M
+
+struct modem_fixture {
+	struct s5xxx_modem sm;
+	u8 *memory;
+	unsigned int doorbells;
+};
+
+static struct modem_fixture *mapping_fixture;
+static struct resource modem_test_resource = {
+	.name = "kunit-s5xxx-registers",
+	.start = 0x100000000ULL,
+	.end = 0x100000000ULL + TEST_IO_SIZE - 1,
+	.flags = IORESOURCE_MEM,
+};
+
+static unsigned long modem_test_read(void *priv, unsigned int offset, int size)
+{
+	struct modem_fixture *f = priv;
+	unsigned long value = 0;
+
+	if (WARN_ON(offset > TEST_IO_SIZE - size))
+		return ~0UL;
+	memcpy(&value, f->memory + offset, size);
+	return value;
+}
+
+static void modem_test_write(void *priv, unsigned int offset, int size,
+			     unsigned long value)
+{
+	struct modem_fixture *f = priv;
+
+	if (WARN_ON(offset > TEST_IO_SIZE - size))
+		return;
+	memcpy(f->memory + offset, &value, size);
+	if (offset == TEST_DOORBELL)
+		f->doorbells++;
+}
+
+static void modem_test_copy_from(void *priv, void *buffer,
+				 unsigned int offset, int size)
+{
+	struct modem_fixture *f = priv;
+
+	if (WARN_ON(offset > TEST_IO_SIZE - size))
+		return;
+	memcpy(buffer, f->memory + offset, size);
+}
+
+static void modem_test_copy_to(void *priv, unsigned int offset,
+			       const void *buffer, int size)
+{
+	struct modem_fixture *f = priv;
+
+	if (WARN_ON(offset > TEST_IO_SIZE - size))
+		return;
+	memcpy(f->memory + offset, buffer, size);
+}
+
+static const struct logic_iomem_ops modem_test_io_ops = {
+	.read = modem_test_read,
+	.write = modem_test_write,
+	.copy_from = modem_test_copy_from,
+	.copy_to = modem_test_copy_to,
+};
+
+static long modem_test_map(unsigned long offset, size_t size,
+			   const struct logic_iomem_ops **ops, void **priv)
+{
+	if (!mapping_fixture || offset + size > TEST_IO_SIZE)
+		return -EINVAL;
+	*ops = &modem_test_io_ops;
+	*priv = mapping_fixture;
+	return offset;
+}
+
+static const struct logic_iomem_region_ops modem_test_region_ops = {
+	.map = modem_test_map,
+};
+
+static int modem_suite_init(struct kunit_suite *suite)
+{
+	return logic_iomem_add_region(&modem_test_resource, &modem_test_region_ops);
+}
+
+static void modem_test_cleanup(void *data)
+{
+	struct modem_fixture *f = data;
+
+	if (f->sm.rfs_endpoint) {
+		s5xxx_rfs_endpoint_detach(f->sm.rfs_endpoint);
+		s5xxx_rfs_endpoint_put(f->sm.rfs_endpoint);
+	}
+	if (f->sm.ipc)
+		iounmap(f->sm.ipc);
+	vfree(f->memory);
+	mapping_fixture = NULL;
+}
+
+static int modem_test_init(struct kunit *test)
+{
+	struct modem_fixture *f;
+	struct device *parent;
+	int ret;
+
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return -ENOMEM;
+	parent = kunit_device_register(test, test->name);
+	if (IS_ERR(parent))
+		return PTR_ERR(parent);
+	ret = kunit_add_action_or_reset(test, modem_test_cleanup, f);
+	if (ret)
+		return ret;
+	f->memory = vzalloc(TEST_IO_SIZE);
+	if (!f->memory)
+		return -ENOMEM;
+	mapping_fixture = f;
+	f->sm.ipc = ioremap(modem_test_resource.start, TEST_IO_SIZE);
+	if (!f->sm.ipc)
+		return -ENOMEM;
+	f->sm.doorbell = f->sm.ipc + TEST_DOORBELL;
+	f->sm.dev = parent;
+	f->sm.link_up = true;
+	f->sm.online = true;
+	spin_lock_init(&f->sm.tx_lock);
+	spin_lock_init(&f->sm.lock);
+	f->sm.rfs_endpoint = s5xxx_rfs_endpoint_create(parent, s5xxx_rfs_emit, &f->sm);
+	if (IS_ERR(f->sm.rfs_endpoint)) {
+		ret = PTR_ERR(f->sm.rfs_endpoint);
+		f->sm.rfs_endpoint = NULL;
+		return ret;
+	}
+	test->priv = f;
+	return 0;
+}
+
+/* The session is separate because endpoint internals remain private. The real
+ * callback accepts precisely this session/epoch pair from the real endpoint.
+ */
+static struct s5xxx_rfs_session *modem_test_owner(struct kunit *test, u64 *epoch)
+{
+	struct s5xxx_rfs_session *s = kunit_kzalloc(test, sizeof(*s), GFP_KERNEL);
+
+	if (!s)
+		return NULL;
+	s5xxx_rfs_session_init(s);
+	if (s5xxx_rfs_session_open(s, epoch))
+		return NULL;
+	return s;
+}
+
+static void modem_real_tx_framing(struct kunit *test)
+{
+	struct modem_fixture *f = test->priv;
+	struct s5xxx_rfs_session *s;
+	u8 frame[8] = {3, 0, 7, 0};
+	u8 *packet = f->memory + S5XXX_RAW_TXQ_BUFF;
+	u64 epoch;
+
+	s = modem_test_owner(test, &epoch);
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_emit(&f->sm, s, epoch, frame, 8), 0);
+	KUNIT_EXPECT_EQ(test, readl(f->sm.ipc + S5XXX_RAW_TXQ_HEAD), 24U);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(packet), (u16)S5XXX_SIT_SYNC);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(packet + 6), (u16)20);
+	KUNIT_EXPECT_EQ(test, packet[8], (u8)S5XXX_CH_RFS);
+	KUNIT_EXPECT_MEMEQ(test, packet + 12, frame, 8);
+	KUNIT_EXPECT_EQ(test, f->doorbells, 1U);
+	KUNIT_EXPECT_EQ(test, readl(f->sm.ipc + S5XXX_IPC_AP2CP_MSG),
+			(u32)(S5XXX_INT_VALID | S5XXX_INT_SEND_RAW));
+}
+
+static void modem_real_tx_full_is_not_partial(struct kunit *test)
+{
+	struct modem_fixture *f = test->priv;
+	struct s5xxx_rfs_session *s;
+	u8 frame[8] = {};
+	u64 epoch;
+
+	s = modem_test_owner(test, &epoch);
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	writel(1, f->sm.ipc + S5XXX_RAW_TXQ_TAIL);
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_emit(&f->sm, s, epoch, frame, 8), -EAGAIN);
+	KUNIT_EXPECT_EQ(test, readl(f->sm.ipc + S5XXX_RAW_TXQ_HEAD), 0U);
+	KUNIT_EXPECT_EQ(test, f->sm.frame_seq, (u16)0);
+	KUNIT_EXPECT_EQ(test, f->sm.rfs_ch_seq, (u8)0);
+	KUNIT_EXPECT_EQ(test, f->doorbells, 0U);
+	writel(0, f->sm.ipc + S5XXX_RAW_TXQ_TAIL);
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_emit(&f->sm, s, epoch, frame, 8), 0);
+	KUNIT_EXPECT_EQ(test, f->doorbells, 1U);
+}
+
+static void modem_real_tx_stale_epoch_is_not_published(struct kunit *test)
+{
+	struct modem_fixture *f = test->priv;
+	struct s5xxx_rfs_session *s;
+	u8 frame[8] = {};
+	u64 epoch;
+
+	s = modem_test_owner(test, &epoch);
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	s5xxx_rfs_session_reset(s);
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_emit(&f->sm, s, epoch, frame, 8), -EPIPE);
+	KUNIT_EXPECT_EQ(test, readl(f->sm.ipc + S5XXX_RAW_TXQ_HEAD), 0U);
+	KUNIT_EXPECT_EQ(test, f->doorbells, 0U);
+}
+
+static void modem_real_tx_wraps_header_and_payload(struct kunit *test)
+{
+	struct modem_fixture *f = test->priv;
+	struct s5xxx_rfs_session *s;
+	u8 frame[8] = {3, 0, 9, 0};
+	u8 packet[20];
+	u64 epoch;
+
+	s = modem_test_owner(test, &epoch);
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	writel(S5XXX_RAW_TXQ_SIZE - 8, f->sm.ipc + S5XXX_RAW_TXQ_HEAD);
+	writel(128, f->sm.ipc + S5XXX_RAW_TXQ_TAIL);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_emit(&f->sm, s, epoch, frame, 8), 0);
+	s5xxx_circ_read(packet, f->sm.ipc + S5XXX_RAW_TXQ_BUFF,
+			S5XXX_RAW_TXQ_SIZE, S5XXX_RAW_TXQ_SIZE - 8, 20);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(packet), (u16)S5XXX_SIT_SYNC);
+	KUNIT_EXPECT_MEMEQ(test, packet + 12, frame, 8);
+	KUNIT_EXPECT_EQ(test, readl(f->sm.ipc + S5XXX_RAW_TXQ_HEAD), 16U);
+	KUNIT_EXPECT_EQ(test, f->doorbells, 1U);
+}
+
+static void modem_real_queue_reset_clears_ring(struct kunit *test)
+{
+	struct modem_fixture *f = test->priv;
+
+	writel(128, f->sm.ipc + S5XXX_RAW_TXQ_HEAD);
+	writel(24, f->sm.ipc + S5XXX_RAW_RXQ_TAIL);
+	f->sm.rfs_ch_seq = 23;
+	s5xxx_init_ipc_queues(&f->sm);
+	KUNIT_EXPECT_EQ(test, readl(f->sm.ipc + S5XXX_RAW_TXQ_HEAD), 0U);
+	KUNIT_EXPECT_EQ(test, readl(f->sm.ipc + S5XXX_RAW_RXQ_TAIL), 0U);
+	KUNIT_EXPECT_EQ(test, f->sm.rfs_ch_seq, (u8)0);
+	KUNIT_EXPECT_EQ(test, readl(f->sm.ipc + S5XXX_IPC_MAGIC), (u32)S5XXX_IPC_MAGIC_VALUE);
+}
+
+static struct sk_buff *modem_test_rfs_frame(void)
+{
+	struct sk_buff *skb = alloc_skb(8, GFP_KERNEL);
+
+	if (skb)
+		skb_put_zero(skb, 8);
+	return skb;
+}
+
+static void modem_test_raw_packet(struct modem_fixture *f, u16 sync,
+				  u16 length, u32 declared_payload)
+{
+	u8 *packet = f->memory + S5XXX_RAW_RXQ_BUFF;
+
+	put_unaligned_le16(sync, packet);
+	put_unaligned_le16(length, packet + 6);
+	packet[8] = S5XXX_CH_RFS;
+	put_unaligned_le32(declared_payload, packet + S5XXX_SIT_HDR + 4);
+	writel(ALIGN(max_t(u16, length, S5XXX_SIT_HDR), 8),
+	       f->sm.ipc + S5XXX_RAW_RXQ_HEAD);
+}
+
+static void modem_real_rx_routes_one_record_without_reply(struct kunit *test)
+{
+	struct modem_fixture *f = test->priv;
+	struct sk_buff *skb;
+	int i;
+
+	modem_test_raw_packet(f, S5XXX_SIT_SYNC, 20, 0);
+	s5xxx_drain_raw_rxq(&f->sm, 0);
+	KUNIT_EXPECT_EQ(test, readl(f->sm.ipc + S5XXX_RAW_RXQ_TAIL), 24U);
+	KUNIT_EXPECT_EQ(test, readl(f->sm.ipc + S5XXX_RAW_TXQ_HEAD), 0U);
+	KUNIT_EXPECT_EQ(test, f->doorbells, 0U);
+	/* Exactly one pre-open record occupied the bounded native queue. */
+	for (i = 0; i < S5XXX_RFS_RX_FRAMES - 1; i++) {
+		skb = modem_test_rfs_frame();
+		KUNIT_ASSERT_NOT_NULL(test, skb);
+		KUNIT_ASSERT_EQ(test, s5xxx_rfs_endpoint_rx(f->sm.rfs_endpoint, skb), 0);
+	}
+	skb = modem_test_rfs_frame();
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_endpoint_rx(f->sm.rfs_endpoint, skb), -ENOBUFS);
+}
+
+static void modem_test_expect_revoked(struct kunit *test)
+{
+	struct modem_fixture *f = test->priv;
+	struct sk_buff *skb = modem_test_rfs_frame();
+
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_endpoint_rx(f->sm.rfs_endpoint, skb), -EIO);
+	KUNIT_EXPECT_EQ(test, readl(f->sm.ipc + S5XXX_RAW_TXQ_HEAD), 0U);
+	KUNIT_EXPECT_EQ(test, f->doorbells, 0U);
+}
+
+static void modem_real_rx_invalid_rfs_revokes(struct kunit *test)
+{
+	struct modem_fixture *f = test->priv;
+
+	modem_test_raw_packet(f, S5XXX_SIT_SYNC, 20, 1);
+	s5xxx_drain_raw_rxq(&f->sm, 0);
+	modem_test_expect_revoked(test);
+}
+
+static void modem_real_rx_bad_sync_revokes(struct kunit *test)
+{
+	struct modem_fixture *f = test->priv;
+
+	modem_test_raw_packet(f, 0, 20, 0);
+	s5xxx_drain_raw_rxq(&f->sm, 0);
+	modem_test_expect_revoked(test);
+}
+
+static void modem_real_rx_bad_pointer_revokes(struct kunit *test)
+{
+	struct modem_fixture *f = test->priv;
+
+	writel(S5XXX_RAW_RXQ_SIZE, f->sm.ipc + S5XXX_RAW_RXQ_HEAD);
+	s5xxx_drain_raw_rxq(&f->sm, 0);
+	modem_test_expect_revoked(test);
+}
+
+static void modem_real_rx_short_link_header_revokes(struct kunit *test)
+{
+	struct modem_fixture *f = test->priv;
+
+	modem_test_raw_packet(f, S5XXX_SIT_SYNC, 1, 0);
+	s5xxx_drain_raw_rxq(&f->sm, 0);
+	modem_test_expect_revoked(test);
+}
+
+static void modem_real_reset_cancels_deferred_doorbell(struct kunit *test)
+{
+	struct modem_fixture *f = test->priv;
+
+	f->sm.db_reserved = true;
+	writel(S5XXX_INT_VALID | S5XXX_INT_SEND_RAW,
+	       f->sm.ipc + S5XXX_IPC_AP2CP_MSG);
+	s5xxx_rfs_revoke(&f->sm);
+	KUNIT_EXPECT_FALSE(test, f->sm.online);
+	KUNIT_EXPECT_FALSE(test, f->sm.db_reserved);
+	KUNIT_EXPECT_EQ(test, readl(f->sm.ipc + S5XXX_IPC_AP2CP_MSG), 0U);
+	KUNIT_EXPECT_EQ(test, f->doorbells, 0U);
+}
+
+static void modem_real_queue_reset_cancels_deferred_doorbell(struct kunit *test)
+{
+	struct modem_fixture *f = test->priv;
+
+	f->sm.db_reserved = true;
+	writel(S5XXX_INT_VALID | S5XXX_INT_SEND_RAW,
+	       f->sm.ipc + S5XXX_IPC_AP2CP_MSG);
+	s5xxx_init_ipc_queues(&f->sm);
+	KUNIT_EXPECT_FALSE(test, f->sm.db_reserved);
+	KUNIT_EXPECT_EQ(test, readl(f->sm.ipc + S5XXX_IPC_AP2CP_MSG), 0U);
+	KUNIT_EXPECT_EQ(test, f->doorbells, 0U);
+}
+
+static void modem_real_tx_preserves_factory_open_extension(struct kunit *test)
+{
+	struct modem_fixture *f = test->priv;
+	struct s5xxx_rfs_session *session;
+	const u8 golden[] = { 3, 0, 0x34, 0x12, 8, 0, 0, 0,
+			      0, 0, 0, 0, 40, 0, 0, 0, 1, 8, 0, 0 };
+	u8 *packet = f->memory + S5XXX_RAW_TXQ_BUFF;
+	u64 epoch;
+
+	session = modem_test_owner(test, &epoch);
+	KUNIT_ASSERT_NOT_NULL(test, session);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_emit(&f->sm, session, epoch,
+					  golden, sizeof(golden)), 0);
+	KUNIT_EXPECT_EQ(test, readl(f->sm.ipc + S5XXX_RAW_TXQ_HEAD), 32U);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(packet + 6), (u16)32);
+	KUNIT_EXPECT_EQ(test, packet[8], (u8)S5XXX_CH_RFS);
+	KUNIT_EXPECT_MEMEQ(test, packet + 12, golden, sizeof(golden));
+	KUNIT_EXPECT_EQ(test, f->doorbells, 1U);
+}
+
+static struct kunit_case modem_cases[] = {
+	KUNIT_CASE(modem_real_tx_preserves_factory_open_extension),
+	KUNIT_CASE(modem_real_reset_cancels_deferred_doorbell),
+	KUNIT_CASE(modem_real_queue_reset_cancels_deferred_doorbell),
+	KUNIT_CASE(modem_real_rx_routes_one_record_without_reply),
+	KUNIT_CASE(modem_real_rx_invalid_rfs_revokes),
+	KUNIT_CASE(modem_real_rx_bad_sync_revokes),
+	KUNIT_CASE(modem_real_rx_bad_pointer_revokes),
+	KUNIT_CASE(modem_real_rx_short_link_header_revokes),
+	KUNIT_CASE(modem_real_tx_framing),
+	KUNIT_CASE(modem_real_tx_full_is_not_partial),
+	KUNIT_CASE(modem_real_tx_stale_epoch_is_not_published),
+	KUNIT_CASE(modem_real_tx_wraps_header_and_payload),
+	KUNIT_CASE(modem_real_queue_reset_clears_ring),
+	{}
+};
+
+static struct kunit_suite modem_suite = {
+	.name = "s5xxx-modem-registers",
+	.suite_init = modem_suite_init,
+	.init = modem_test_init,
+	.test_cases = modem_cases,
+};
+kunit_test_suite(modem_suite);
diff --git a/drivers/net/wwan/s5xxx_rfs_endpoint.c b/drivers/net/wwan/s5xxx_rfs_endpoint.c
new file mode 100644
index 000000000..aad58bef0
--- /dev/null
+++ b/drivers/net/wwan/s5xxx_rfs_endpoint.c
@@ -0,0 +1,278 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Root-only record transport. This component itself performs no modem I/O. */
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/fs.h>
+#include <linux/kref.h>
+#include <linux/jiffies.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/uio.h>
+#include "s5xxx_rfs_endpoint.h"
+
+struct s5xxx_rfs_endpoint {
+	struct miscdevice misc;
+	struct kref refs;
+	struct mutex io_lock;
+	struct s5xxx_rfs_session session;
+	atomic_t registered;
+	s5xxx_rfs_emit_t emit;
+	void *context;
+};
+
+struct rfs_open_file {
+	struct s5xxx_rfs_endpoint *ep;
+	u64 epoch;
+};
+
+static void endpoint_free(struct kref *refs)
+{
+	struct s5xxx_rfs_endpoint *ep =
+		container_of(refs, struct s5xxx_rfs_endpoint, refs);
+
+	WARN_ON(atomic_read(&ep->registered));
+	s5xxx_rfs_session_shutdown(&ep->session);
+	kfree(ep->misc.name);
+	kfree(ep);
+}
+
+static int endpoint_open(struct inode *inode, struct file *file)
+{
+	struct miscdevice *misc = file->private_data;
+	struct s5xxx_rfs_endpoint *ep =
+		container_of(misc, struct s5xxx_rfs_endpoint, misc);
+	struct rfs_open_file *opened;
+	int ret;
+
+	opened = kzalloc(sizeof(*opened), GFP_KERNEL);
+	if (!opened)
+		return -ENOMEM;
+	mutex_lock(&ep->io_lock);
+	ret = s5xxx_rfs_session_open(&ep->session, &opened->epoch);
+	if (!ret) {
+		kref_get(&ep->refs);
+		opened->ep = ep;
+		file->private_data = opened;
+	}
+	mutex_unlock(&ep->io_lock);
+	if (ret) {
+		kfree(opened);
+		return ret;
+	}
+	return stream_open(inode, file);
+}
+
+static int endpoint_release(struct inode *inode, struct file *file)
+{
+	struct rfs_open_file *opened = file->private_data;
+	struct s5xxx_rfs_endpoint *ep = opened->ep;
+
+	mutex_lock(&ep->io_lock);
+	s5xxx_rfs_session_close(&ep->session, opened->epoch);
+	mutex_unlock(&ep->io_lock);
+	kfree(opened);
+	file->private_data = NULL;
+	kref_put(&ep->refs, endpoint_free);
+	return 0;
+}
+
+static ssize_t endpoint_read(struct kiocb *iocb, struct iov_iter *to)
+{
+	struct rfs_open_file *opened = iocb->ki_filp->private_data;
+	struct s5xxx_rfs_endpoint *ep = opened->ep;
+	struct sk_buff *skb;
+	__poll_t mask;
+	ssize_t ret;
+
+	if (!iov_iter_count(to))
+		return 0;
+	for (;;) {
+		ret = mutex_lock_interruptible(&ep->io_lock);
+		if (ret)
+			return ret;
+		skb = s5xxx_rfs_session_take(&ep->session, opened->epoch,
+					   iov_iter_count(to));
+		if (!IS_ERR(skb))
+			break;
+		ret = PTR_ERR(skb);
+		mutex_unlock(&ep->io_lock);
+		if (ret != -EAGAIN || (iocb->ki_filp->f_flags & O_NONBLOCK))
+			return ret;
+		ret = wait_event_interruptible(ep->session.wait,
+			s5xxx_rfs_session_poll(&ep->session, opened->epoch) &
+			(EPOLLIN | EPOLLERR | EPOLLHUP));
+		if (ret)
+			return ret;
+	}
+	if (copy_to_iter(skb->data, skb->len, to) != skb->len) {
+		/* Never let a partially copied record advance the protocol. */
+		s5xxx_rfs_session_lost(&ep->session, opened->epoch);
+		ret = -EFAULT;
+	} else {
+		mask = s5xxx_rfs_session_poll(&ep->session, opened->epoch);
+		ret = (mask & EPOLLHUP) ? -ENODEV :
+		      (mask & EPOLLERR) ? -EPIPE : skb->len;
+	}
+	kfree_skb(skb);
+	mutex_unlock(&ep->io_lock);
+	return ret;
+}
+
+static ssize_t endpoint_write(struct kiocb *iocb, struct iov_iter *from)
+{
+	struct rfs_open_file *opened = iocb->ki_filp->private_data;
+	struct s5xxx_rfs_endpoint *ep = opened->ep;
+	size_t length = iov_iter_count(from);
+	__poll_t mask;
+	void *frame;
+	unsigned long deadline = jiffies + msecs_to_jiffies(30000);
+	long waited;
+	int ret;
+
+	if (length < 8 || length > S5XXX_RFS_FRAME_MAX)
+		return -EMSGSIZE;
+	frame = kmalloc(length, GFP_KERNEL);
+	if (!frame)
+		return -ENOMEM;
+	if (!copy_from_iter_full(frame, length, from)) {
+		ret = -EFAULT;
+		goto free;
+	}
+	if (!s5xxx_rfs_tx_frame_valid(frame, length)) {
+		ret = -EPROTO;
+		goto free;
+	}
+retry:
+	ret = mutex_lock_interruptible(&ep->io_lock);
+	if (ret)
+		goto free;
+	mask = s5xxx_rfs_session_poll(&ep->session, opened->epoch);
+	if (!ep->emit || (mask & EPOLLHUP))
+		ret = -ENODEV;
+	else if (mask & EPOLLERR)
+		ret = -EPIPE;
+	else {
+		ret = ep->emit(ep->context, &ep->session, opened->epoch,
+			       frame, length);
+		if (ret > 0) {
+			/* The callback must never report an ambiguous short send. */
+			s5xxx_rfs_session_lost(&ep->session, opened->epoch);
+			ret = -EIO;
+		}
+	}
+	mutex_unlock(&ep->io_lock);
+	if (ret == -EAGAIN && !(iocb->ki_filp->f_flags & O_NONBLOCK) &&
+	    time_before(jiffies, deadline)) {
+		/* No record was published. Retain this frame and epoch while waiting.
+		 * CP reset/removal wakes immediately; ring space is retried at 50 Hz.
+		 * Keep io_lock released so reads and detach cannot deadlock behind TX.
+		 */
+		waited = wait_event_interruptible_timeout(ep->session.wait,
+			s5xxx_rfs_session_poll(&ep->session, opened->epoch) &
+			(EPOLLERR | EPOLLHUP), msecs_to_jiffies(20));
+		if (waited < 0) {
+			ret = waited;
+			goto free;
+		}
+		goto retry;
+	}
+free:
+	kfree(frame);
+	if (ret)
+		return ret;
+	return length;
+}
+
+static __poll_t endpoint_poll(struct file *file, poll_table *wait)
+{
+	struct rfs_open_file *opened = file->private_data;
+	struct s5xxx_rfs_endpoint *ep = opened->ep;
+
+	poll_wait(file, &ep->session.wait, wait);
+	return s5xxx_rfs_session_poll(&ep->session, opened->epoch);
+}
+
+static const struct file_operations endpoint_fops = {
+	.owner = THIS_MODULE,
+	.open = endpoint_open,
+	.release = endpoint_release,
+	.read_iter = endpoint_read,
+	.write_iter = endpoint_write,
+	.poll = endpoint_poll,
+};
+
+struct s5xxx_rfs_endpoint *s5xxx_rfs_endpoint_create(struct device *parent,
+					 s5xxx_rfs_emit_t emit, void *context)
+{
+	struct s5xxx_rfs_endpoint *ep;
+	int ret;
+
+	if (!parent || !emit)
+		return ERR_PTR(-EINVAL);
+	ep = kzalloc(sizeof(*ep), GFP_KERNEL);
+	if (!ep)
+		return ERR_PTR(-ENOMEM);
+	kref_init(&ep->refs);
+	mutex_init(&ep->io_lock);
+	s5xxx_rfs_session_init(&ep->session);
+	ep->emit = emit;
+	ep->context = context;
+	ep->misc.name = kasprintf(GFP_KERNEL, "s5xxx-rfs-%s", dev_name(parent));
+	if (!ep->misc.name) {
+		ret = -ENOMEM;
+		goto fail;
+	}
+	ep->misc.minor = MISC_DYNAMIC_MINOR;
+	ep->misc.fops = &endpoint_fops;
+	ep->misc.parent = parent;
+	ep->misc.mode = 0600;
+	ret = misc_register(&ep->misc);
+	if (ret)
+		goto fail;
+	atomic_set(&ep->registered, 1);
+	return ep;
+fail:
+	kref_put(&ep->refs, endpoint_free);
+	return ERR_PTR(ret);
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_endpoint_create);
+
+void s5xxx_rfs_endpoint_detach(struct s5xxx_rfs_endpoint *ep)
+{
+	/* misc_open and misc_deregister serialize new opens with the misc lock. */
+	if (atomic_xchg(&ep->registered, 0))
+		misc_deregister(&ep->misc);
+	mutex_lock(&ep->io_lock);
+	s5xxx_rfs_session_shutdown(&ep->session);
+	ep->emit = NULL;
+	ep->context = NULL;
+	mutex_unlock(&ep->io_lock);
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_endpoint_detach);
+
+void s5xxx_rfs_endpoint_put(struct s5xxx_rfs_endpoint *ep)
+{
+	kref_put(&ep->refs, endpoint_free);
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_endpoint_put);
+
+void s5xxx_rfs_endpoint_reset(struct s5xxx_rfs_endpoint *ep)
+{
+	s5xxx_rfs_session_reset(&ep->session);
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_endpoint_reset);
+
+int s5xxx_rfs_endpoint_rx(struct s5xxx_rfs_endpoint *ep, struct sk_buff *skb)
+{
+	return s5xxx_rfs_session_rx(&ep->session, skb);
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_endpoint_rx);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Reference-counted record endpoint for native Exynos RFS");
+
+#if IS_ENABLED(CONFIG_S5XXX_RFS_SESSION_KUNIT_TEST)
+#include "s5xxx_rfs_endpoint_test.c"
+#endif
diff --git a/drivers/net/wwan/s5xxx_rfs_endpoint.h b/drivers/net/wwan/s5xxx_rfs_endpoint.h
new file mode 100644
index 000000000..237bafd01
--- /dev/null
+++ b/drivers/net/wwan/s5xxx_rfs_endpoint.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _S5XXX_RFS_ENDPOINT_H
+#define _S5XXX_RFS_ENDPOINT_H
+#include "s5xxx_rfs_session.h"
+
+struct device;
+struct s5xxx_rfs_endpoint;
+/*
+ * Synchronous emission: return zero only after the full frame is published.
+ * The modem callback must take its TX lock, then the supplied session's TX
+ * gate, and retain both through the complete write/doorbell operation.
+ */
+typedef int (*s5xxx_rfs_emit_t)(void *context,
+			      struct s5xxx_rfs_session *session, u64 epoch,
+			      const void *frame, size_t length);
+struct s5xxx_rfs_endpoint *s5xxx_rfs_endpoint_create(struct device *parent,
+					 s5xxx_rfs_emit_t emit, void *context);
+/* Stop new opens/TX, invalidate open files; retain the driver's reference. */
+void s5xxx_rfs_endpoint_detach(struct s5xxx_rfs_endpoint *ep);
+/* Driver drops this reference only after its RX/reset IRQs are quiesced. */
+void s5xxx_rfs_endpoint_put(struct s5xxx_rfs_endpoint *ep);
+void s5xxx_rfs_endpoint_reset(struct s5xxx_rfs_endpoint *ep);
+int s5xxx_rfs_endpoint_rx(struct s5xxx_rfs_endpoint *ep, struct sk_buff *skb);
+#endif
diff --git a/drivers/net/wwan/s5xxx_rfs_endpoint_test.c b/drivers/net/wwan/s5xxx_rfs_endpoint_test.c
new file mode 100644
index 000000000..1ba7dc03c
--- /dev/null
+++ b/drivers/net/wwan/s5xxx_rfs_endpoint_test.c
@@ -0,0 +1,337 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <kunit/test.h>
+#include <kunit/device.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/kthread.h>
+#include <linux/unaligned.h>
+
+struct endpoint_fixture {
+	struct s5xxx_rfs_endpoint *ep;
+	struct file files[2];
+	bool opened[2];
+	int emitted, result, retries;
+};
+
+static int test_emit(void *data, struct s5xxx_rfs_session *s, u64 epoch,
+		     const void *frame, size_t length)
+{
+	struct endpoint_fixture *f = data;
+	unsigned long flags;
+	int ret = s5xxx_rfs_session_tx_begin(s, epoch, &flags);
+
+	if (ret)
+		return ret;
+	if (f->retries > 0) {
+		f->retries--;
+		s5xxx_rfs_session_tx_end(s, flags);
+		return -EAGAIN;
+	}
+	if (!f->result)
+		f->emitted++;
+	s5xxx_rfs_session_tx_end(s, flags);
+	return f->result;
+}
+
+static void endpoint_cleanup(void *data)
+{
+	struct endpoint_fixture *f = data;
+	int i;
+
+	for (i = 0; i < 2; i++)
+		if (f->opened[i])
+			endpoint_release(NULL, &f->files[i]);
+	if (f->ep) {
+		s5xxx_rfs_endpoint_detach(f->ep);
+		s5xxx_rfs_endpoint_put(f->ep);
+	}
+}
+
+static int endpoint_test_init(struct kunit *test)
+{
+	struct endpoint_fixture *f;
+	struct device *parent;
+
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return -ENOMEM;
+	parent = kunit_device_register(test, test->name);
+	if (IS_ERR(parent))
+		return PTR_ERR(parent);
+	f->ep = s5xxx_rfs_endpoint_create(parent, test_emit, f);
+	if (IS_ERR(f->ep))
+		return PTR_ERR(f->ep);
+	test->priv = f;
+	return kunit_add_action_or_reset(test, endpoint_cleanup, f);
+}
+
+static int test_open(struct endpoint_fixture *f, int i)
+{
+	int ret;
+
+	f->files[i].private_data = &f->ep->misc;
+	f->files[i].f_flags = O_NONBLOCK;
+	ret = endpoint_open(NULL, &f->files[i]);
+	if (!ret)
+		f->opened[i] = true;
+	return ret;
+}
+
+static ssize_t test_io(struct file *file, void *data, size_t size, bool write)
+{
+	struct kiocb iocb = { .ki_filp = file };
+	struct kvec vector = { .iov_base = data, .iov_len = size };
+	struct iov_iter iter;
+
+	iov_iter_kvec(&iter, write ? ITER_SOURCE : ITER_DEST, &vector, 1, size);
+	return write ? endpoint_write(&iocb, &iter) : endpoint_read(&iocb, &iter);
+}
+
+static int test_receive(struct endpoint_fixture *f)
+{
+	struct sk_buff *skb = alloc_skb(8, GFP_KERNEL);
+
+	if (!skb)
+		return -ENOMEM;
+	skb_put_zero(skb, 8);
+	return s5xxx_rfs_endpoint_rx(f->ep, skb);
+}
+
+static void endpoint_exclusive(struct kunit *test)
+{
+	struct endpoint_fixture *f = test->priv;
+
+	KUNIT_EXPECT_EQ(test, f->ep->misc.mode, (umode_t)0600);
+	KUNIT_ASSERT_EQ(test, test_open(f, 0), 0);
+	KUNIT_EXPECT_EQ(test, test_open(f, 1), -EBUSY);
+}
+
+static void endpoint_record_reads(struct kunit *test)
+{
+	struct endpoint_fixture *f = test->priv;
+	u8 bytes[8];
+
+	KUNIT_ASSERT_EQ(test, test_open(f, 0), 0);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 8, false), (ssize_t)-EAGAIN);
+	KUNIT_ASSERT_EQ(test, test_receive(f), 0);
+	KUNIT_EXPECT_TRUE(test, endpoint_poll(&f->files[0], NULL) & EPOLLIN);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 7, false), (ssize_t)-EMSGSIZE);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 8, false), (ssize_t)8);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 8, false), (ssize_t)-EAGAIN);
+}
+
+static void endpoint_record_writes(struct kunit *test)
+{
+	struct endpoint_fixture *f = test->priv;
+	u8 bytes[8] = {};
+
+	KUNIT_ASSERT_EQ(test, test_open(f, 0), 0);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 8, true), (ssize_t)8);
+	KUNIT_EXPECT_EQ(test, f->emitted, 1);
+	put_unaligned_le32(1, bytes + 4);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 8, true), (ssize_t)-EPROTO);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 7, true), (ssize_t)-EMSGSIZE);
+	KUNIT_EXPECT_EQ(test, f->emitted, 1);
+}
+
+static void endpoint_callback_failures(struct kunit *test)
+{
+	struct endpoint_fixture *f = test->priv;
+	u8 bytes[8] = {};
+
+	KUNIT_ASSERT_EQ(test, test_open(f, 0), 0);
+	f->result = -EAGAIN;
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 8, true), (ssize_t)-EAGAIN);
+	f->result = 1;
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 8, true), (ssize_t)-EIO);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 8, true), (ssize_t)-EPIPE);
+	KUNIT_EXPECT_EQ(test, f->emitted, 0);
+}
+
+static void endpoint_reset_reopen(struct kunit *test)
+{
+	struct endpoint_fixture *f = test->priv;
+	u8 bytes[8] = {};
+
+	KUNIT_ASSERT_EQ(test, test_open(f, 0), 0);
+	s5xxx_rfs_endpoint_reset(f->ep);
+	KUNIT_ASSERT_EQ(test, test_receive(f), 0);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 8, false), (ssize_t)-EPIPE);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 8, true), (ssize_t)-EPIPE);
+	endpoint_release(NULL, &f->files[0]);
+	f->opened[0] = false;
+	KUNIT_ASSERT_EQ(test, test_open(f, 1), 0);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[1], bytes, 8, false), (ssize_t)8);
+}
+
+static void endpoint_detach_open_file(struct kunit *test)
+{
+	struct endpoint_fixture *f = test->priv;
+	u8 bytes[8] = {};
+
+	KUNIT_ASSERT_EQ(test, test_open(f, 0), 0);
+	s5xxx_rfs_endpoint_detach(f->ep);
+	KUNIT_EXPECT_EQ(test, test_open(f, 1), -ENODEV);
+	s5xxx_rfs_endpoint_put(f->ep);
+	f->ep = NULL;
+	KUNIT_EXPECT_TRUE(test, endpoint_poll(&f->files[0], NULL) & EPOLLHUP);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 8, false), (ssize_t)-ENODEV);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 8, true), (ssize_t)-ENODEV);
+}
+
+static void endpoint_copy_faults(struct kunit *test)
+{
+	struct endpoint_fixture *f = test->priv;
+	struct kiocb iocb = { .ki_filp = &f->files[0] };
+	struct iov_iter iter;
+	u8 bytes[8] = {};
+
+	KUNIT_ASSERT_EQ(test, test_open(f, 0), 0);
+	/* Out-of-range uaccess is rejected without needing a user mm. */
+	iov_iter_ubuf(&iter, ITER_SOURCE, (void __user *)~0UL, 8);
+	KUNIT_EXPECT_EQ(test, endpoint_write(&iocb, &iter), (ssize_t)-EFAULT);
+	KUNIT_EXPECT_EQ(test, f->emitted, 0);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 8, true), (ssize_t)8);
+	KUNIT_ASSERT_EQ(test, test_receive(f), 0);
+	iov_iter_ubuf(&iter, ITER_DEST, (void __user *)~0UL, 8);
+	KUNIT_EXPECT_EQ(test, endpoint_read(&iocb, &iter), (ssize_t)-EFAULT);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 8, true), (ssize_t)-EPIPE);
+}
+
+struct endpoint_reader {
+	struct endpoint_fixture *fixture;
+	struct task_struct *task;
+	struct completion done;
+	ssize_t result;
+	bool write;
+};
+
+static int endpoint_reader_thread(void *data)
+{
+	struct endpoint_reader *reader = data;
+	u8 bytes[8] = {};
+
+	reader->result = test_io(&reader->fixture->files[0], bytes, 8, reader->write);
+	complete(&reader->done);
+	while (!kthread_should_stop()) {
+		set_current_state(TASK_INTERRUPTIBLE);
+		if (!kthread_should_stop())
+			schedule();
+	}
+	__set_current_state(TASK_RUNNING);
+	return 0;
+}
+
+static void endpoint_reader_cleanup(void *data)
+{
+	struct endpoint_reader *reader = data;
+
+	s5xxx_rfs_endpoint_detach(reader->fixture->ep);
+	kthread_stop(reader->task);
+}
+
+static void endpoint_detach_wakes_reader(struct kunit *test)
+{
+	struct endpoint_fixture *f = test->priv;
+	struct endpoint_reader *reader;
+	int i;
+
+	KUNIT_ASSERT_EQ(test, test_open(f, 0), 0);
+	f->files[0].f_flags &= ~O_NONBLOCK;
+	reader = kunit_kzalloc(test, sizeof(*reader), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, reader);
+	reader->fixture = f;
+	init_completion(&reader->done);
+	reader->task = kthread_run(endpoint_reader_thread, reader, "rfs-read-test");
+	KUNIT_ASSERT_FALSE(test, IS_ERR(reader->task));
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, endpoint_reader_cleanup, reader), 0);
+	for (i = 0; i < 100 && !waitqueue_active(&f->ep->session.wait); i++)
+		usleep_range(1000, 2000);
+	KUNIT_ASSERT_TRUE(test, waitqueue_active(&f->ep->session.wait));
+	s5xxx_rfs_endpoint_detach(f->ep);
+	KUNIT_ASSERT_NE(test, wait_for_completion_timeout(&reader->done, HZ), 0UL);
+	KUNIT_EXPECT_EQ(test, reader->result, (ssize_t)-ENODEV);
+}
+
+static void endpoint_detach_wakes_backpressured_writer(struct kunit *test)
+{
+	struct endpoint_fixture *f = test->priv;
+	struct endpoint_reader *reader;
+	int i;
+
+	KUNIT_ASSERT_EQ(test, test_open(f, 0), 0);
+	f->files[0].f_flags &= ~O_NONBLOCK;
+	reader = kunit_kzalloc(test, sizeof(*reader), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, reader);
+	reader->fixture = f;
+	reader->write = true;
+	f->result = -EAGAIN;
+	init_completion(&reader->done);
+	reader->task = kthread_run(endpoint_reader_thread, reader, "rfs-write-test");
+	KUNIT_ASSERT_FALSE(test, IS_ERR(reader->task));
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, endpoint_reader_cleanup, reader), 0);
+	for (i = 0; i < 100 && !waitqueue_active(&f->ep->session.wait); i++)
+		usleep_range(1000, 2000);
+	KUNIT_ASSERT_TRUE(test, waitqueue_active(&f->ep->session.wait));
+	s5xxx_rfs_endpoint_detach(f->ep);
+	KUNIT_ASSERT_NE(test, wait_for_completion_timeout(&reader->done, HZ), 0UL);
+	KUNIT_EXPECT_EQ(test, reader->result, (ssize_t)-ENODEV);
+}
+
+static void endpoint_blocking_write_retries_without_duplicate_send(struct kunit *test)
+{
+	struct endpoint_fixture *f = test->priv;
+	u8 bytes[8] = {};
+
+	KUNIT_ASSERT_EQ(test, test_open(f, 0), 0);
+	f->files[0].f_flags &= ~O_NONBLOCK;
+	f->retries = 2;
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], bytes, 8, true), (ssize_t)8);
+	KUNIT_EXPECT_EQ(test, f->retries, 0);
+	KUNIT_EXPECT_EQ(test, f->emitted, 1);
+}
+
+/* Exact CP41 factory successful OPEN: declared body 8 plus size extension. */
+static void endpoint_factory_open_status_extension(struct kunit *test)
+{
+	struct endpoint_fixture *f = test->priv;
+	u8 golden[21] = { 3, 0, 0x34, 0x12, 8, 0, 0, 0,
+			  0, 0, 0, 0, 40, 0, 0, 0, 1, 8, 0, 0 };
+
+	KUNIT_ASSERT_EQ(test, test_open(f, 0), 0);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], golden, 20, true), (ssize_t)20);
+	KUNIT_EXPECT_EQ(test, f->emitted, 1);
+	golden[0] = 1;
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], golden, 20, true), (ssize_t)-EPROTO);
+	golden[0] = 3;
+	golden[8] = 1;
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], golden, 20, true), (ssize_t)-EPROTO);
+	golden[8] = 0;
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], golden, 19, true), (ssize_t)-EPROTO);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], golden, 21, true), (ssize_t)-EPROTO);
+	put_unaligned_le32(U32_MAX, golden + 4);
+	KUNIT_EXPECT_EQ(test, test_io(&f->files[0], golden, 20, true), (ssize_t)-EPROTO);
+	KUNIT_EXPECT_EQ(test, f->emitted, 1);
+}
+
+static struct kunit_case endpoint_cases[] = {
+	KUNIT_CASE(endpoint_factory_open_status_extension),
+	KUNIT_CASE(endpoint_detach_wakes_backpressured_writer),
+	KUNIT_CASE(endpoint_blocking_write_retries_without_duplicate_send),
+	KUNIT_CASE(endpoint_detach_wakes_reader),
+	KUNIT_CASE(endpoint_copy_faults),
+	KUNIT_CASE(endpoint_exclusive),
+	KUNIT_CASE(endpoint_record_reads),
+	KUNIT_CASE(endpoint_record_writes),
+	KUNIT_CASE(endpoint_callback_failures),
+	KUNIT_CASE(endpoint_reset_reopen),
+	KUNIT_CASE(endpoint_detach_open_file),
+	{}
+};
+
+static struct kunit_suite endpoint_suite = {
+	.name = "s5xxx-rfs-endpoint",
+	.init = endpoint_test_init,
+	.test_cases = endpoint_cases,
+};
+kunit_test_suite(endpoint_suite);
diff --git a/drivers/net/wwan/s5xxx_rfs_session.c b/drivers/net/wwan/s5xxx_rfs_session.c
new file mode 100644
index 000000000..95795cdd6
--- /dev/null
+++ b/drivers/net/wwan/s5xxx_rfs_session.c
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Bounded single-owner RFS session state; no firmware or modem I/O. */
+#include <linux/errno.h>
+#include <linux/err.h>
+#include <linux/limits.h>
+#include <linux/module.h>
+#include <linux/unaligned.h>
+
+#include "s5xxx_rfs_session.h"
+
+static void rfs_advance(struct s5xxx_rfs_session *s)
+{
+	lockdep_assert_held(&s->rxq.lock);
+	/* Never recycle an epoch while an old descriptor can still exist. */
+	if (s->epoch == U64_MAX)
+		s->dead = true;
+	else
+		s->epoch++;
+}
+
+static int rfs_check(struct s5xxx_rfs_session *s, u64 epoch)
+{
+	lockdep_assert_held(&s->rxq.lock);
+	if (s->dead)
+		return -ENODEV;
+	if (epoch != s->epoch)
+		return -EPIPE;
+	if (s->failed)
+		return -EIO;
+	if (!s->opened || epoch != s->open_epoch)
+		return -ENOTCONN;
+	return 0;
+}
+
+static void rfs_fail(struct s5xxx_rfs_session *s)
+{
+	lockdep_assert_held(&s->rxq.lock);
+	if (s->dead || s->failed)
+		return;
+	__skb_queue_purge(&s->rxq);
+	s->failed = true;
+	rfs_advance(s);
+}
+
+void s5xxx_rfs_session_init(struct s5xxx_rfs_session *s)
+{
+	skb_queue_head_init(&s->rxq);
+	init_waitqueue_head(&s->wait);
+	s->epoch = 1;
+	s->open_epoch = 0;
+	s->opened = false;
+	s->failed = false;
+	s->dead = false;
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_session_init);
+
+int s5xxx_rfs_session_open(struct s5xxx_rfs_session *s, u64 *epoch)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&s->rxq.lock, flags);
+	if (s->dead)
+		ret = -ENODEV;
+	else if (s->failed)
+		ret = -EIO;
+	else if (s->opened)
+		ret = -EBUSY;
+	else {
+		s->opened = true;
+		s->open_epoch = s->epoch;
+		*epoch = s->epoch;
+	}
+	spin_unlock_irqrestore(&s->rxq.lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_session_open);
+
+void s5xxx_rfs_session_close(struct s5xxx_rfs_session *s, u64 epoch)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&s->rxq.lock, flags);
+	if (s->opened && epoch == s->open_epoch) {
+		s->opened = false;
+		if (!s->dead && epoch == s->epoch) {
+			__skb_queue_purge(&s->rxq);
+			rfs_advance(s);
+		}
+		/* Closing a revoked FD must retain newer pre-open requests. */
+	}
+	spin_unlock_irqrestore(&s->rxq.lock, flags);
+	wake_up_interruptible(&s->wait);
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_session_close);
+
+void s5xxx_rfs_session_reset(struct s5xxx_rfs_session *s)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&s->rxq.lock, flags);
+	if (!s->dead) {
+		__skb_queue_purge(&s->rxq);
+		rfs_advance(s);
+		s->failed = false;
+	}
+	spin_unlock_irqrestore(&s->rxq.lock, flags);
+	wake_up_interruptible(&s->wait);
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_session_reset);
+
+void s5xxx_rfs_session_lost(struct s5xxx_rfs_session *s, u64 epoch)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&s->rxq.lock, flags);
+	/* A copy fault on a revoked FD must not poison newer CP requests. */
+	if (!rfs_check(s, epoch))
+		rfs_fail(s);
+	spin_unlock_irqrestore(&s->rxq.lock, flags);
+	wake_up_interruptible(&s->wait);
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_session_lost);
+
+void s5xxx_rfs_session_shutdown(struct s5xxx_rfs_session *s)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&s->rxq.lock, flags);
+	s->dead = true;
+	__skb_queue_purge(&s->rxq);
+	spin_unlock_irqrestore(&s->rxq.lock, flags);
+	wake_up_interruptible(&s->wait);
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_session_shutdown);
+
+bool s5xxx_rfs_frame_valid(const void *data, size_t length)
+{
+	return data && length >= 8 && length <= S5XXX_RFS_FRAME_MAX &&
+		get_unaligned_le32((const u8 *)data + 4) == length - 8;
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_frame_valid);
+
+bool s5xxx_rfs_tx_frame_valid(const void *data, size_t length)
+{
+	const u8 *bytes = data;
+
+	if (s5xxx_rfs_frame_valid(data, length))
+		return true;
+	/* Exact CP41 factory successful OPEN: body count excludes a trailing
+	 * u32 file size. Only this bounded outbound status record is special;
+	 * receive validation remains strict and still revokes malformed RX.
+	 */
+	return bytes && length == 20 &&
+		get_unaligned_le16(bytes) == 3 &&
+		get_unaligned_le32(bytes + 4) == 8 &&
+		get_unaligned_le32(bytes + 8) == 0;
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_tx_frame_valid);
+
+int s5xxx_rfs_session_rx(struct s5xxx_rfs_session *s, struct sk_buff *skb)
+{
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&s->rxq.lock, flags);
+	if (s->dead)
+		ret = -ENODEV;
+	else if (s->failed)
+		ret = -EIO;
+	else if (!skb) {
+		ret = -ENOMEM;
+		rfs_fail(s);
+	} else if (skb_is_nonlinear(skb) ||
+		   !s5xxx_rfs_frame_valid(skb->data, skb->len)) {
+		ret = -EPROTO;
+		rfs_fail(s);
+	} else if (s->rxq.qlen >= S5XXX_RFS_RX_FRAMES) {
+		ret = -ENOBUFS;
+		rfs_fail(s);
+	} else {
+		__skb_queue_tail(&s->rxq, skb);
+		skb = NULL;
+		ret = 0;
+	}
+	spin_unlock_irqrestore(&s->rxq.lock, flags);
+	kfree_skb(skb);
+	wake_up_interruptible(&s->wait);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_session_rx);
+
+struct sk_buff *s5xxx_rfs_session_take(struct s5xxx_rfs_session *s, u64 epoch,
+				     size_t capacity)
+{
+	struct sk_buff *skb;
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&s->rxq.lock, flags);
+	ret = rfs_check(s, epoch);
+	if (ret) {
+		skb = ERR_PTR(ret);
+		goto out;
+	}
+	skb = skb_peek(&s->rxq);
+	if (!skb)
+		skb = ERR_PTR(-EAGAIN);
+	else if (skb->len > capacity)
+		skb = ERR_PTR(-EMSGSIZE);
+	else
+		skb = __skb_dequeue(&s->rxq);
+out:
+	spin_unlock_irqrestore(&s->rxq.lock, flags);
+	return skb;
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_session_take);
+
+__poll_t s5xxx_rfs_session_poll(struct s5xxx_rfs_session *s, u64 epoch)
+{
+	unsigned long flags;
+	__poll_t mask;
+
+	spin_lock_irqsave(&s->rxq.lock, flags);
+	if (s->dead)
+		mask = EPOLLERR | EPOLLHUP;
+	else if (rfs_check(s, epoch))
+		mask = EPOLLERR;
+	else {
+		mask = EPOLLOUT | EPOLLWRNORM;
+		if (!skb_queue_empty(&s->rxq))
+			mask |= EPOLLIN | EPOLLRDNORM;
+	}
+	spin_unlock_irqrestore(&s->rxq.lock, flags);
+	return mask;
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_session_poll);
+
+int s5xxx_rfs_session_tx_begin(struct s5xxx_rfs_session *s, u64 epoch,
+				 unsigned long *flags)
+{
+	int ret;
+
+	spin_lock_irqsave(&s->rxq.lock, *flags);
+	ret = rfs_check(s, epoch);
+	if (ret)
+		spin_unlock_irqrestore(&s->rxq.lock, *flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_session_tx_begin);
+
+void s5xxx_rfs_session_tx_end(struct s5xxx_rfs_session *s, unsigned long flags)
+{
+	spin_unlock_irqrestore(&s->rxq.lock, flags);
+}
+EXPORT_SYMBOL_GPL(s5xxx_rfs_session_tx_end);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Single-owner bounded session state for native Exynos RFS");
diff --git a/drivers/net/wwan/s5xxx_rfs_session.h b/drivers/net/wwan/s5xxx_rfs_session.h
new file mode 100644
index 000000000..57b9bd9f8
--- /dev/null
+++ b/drivers/net/wwan/s5xxx_rfs_session.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _S5XXX_RFS_SESSION_H
+#define _S5XXX_RFS_SESSION_H
+
+#include <linux/poll.h>
+#include <linux/skbuff.h>
+#include <linux/types.h>
+#include <linux/wait.h>
+
+#define S5XXX_RFS_FRAME_MAX 4096
+#define S5XXX_RFS_RX_FRAMES 32
+
+/* All state is protected by rxq.lock. Caller owns the object's lifetime. */
+struct s5xxx_rfs_session {
+	struct sk_buff_head rxq;
+	wait_queue_head_t wait;
+	u64 epoch;
+	u64 open_epoch;
+	bool opened;
+	bool failed;
+	bool dead;
+};
+
+void s5xxx_rfs_session_init(struct s5xxx_rfs_session *s);
+int s5xxx_rfs_session_open(struct s5xxx_rfs_session *s, u64 *epoch);
+void s5xxx_rfs_session_close(struct s5xxx_rfs_session *s, u64 epoch);
+void s5xxx_rfs_session_reset(struct s5xxx_rfs_session *s);
+void s5xxx_rfs_session_lost(struct s5xxx_rfs_session *s, u64 epoch);
+void s5xxx_rfs_session_shutdown(struct s5xxx_rfs_session *s);
+/* Consumes skb on every return, including rejection. NULL signals RX loss. */
+int s5xxx_rfs_session_rx(struct s5xxx_rfs_session *s, struct sk_buff *skb);
+/* One full record; a short user buffer leaves the record queued. */
+struct sk_buff *s5xxx_rfs_session_take(struct s5xxx_rfs_session *s, u64 epoch,
+				     size_t capacity);
+__poll_t s5xxx_rfs_session_poll(struct s5xxx_rfs_session *s, u64 epoch);
+bool s5xxx_rfs_frame_valid(const void *data, size_t length);
+bool s5xxx_rfs_tx_frame_valid(const void *data, size_t length);
+/*
+ * A successful begin retains rxq.lock until end: the caller must publish the
+ * entire TX record while fenced against reset/loss. In the modem driver the
+ * lock order must be modem TX lock -> session lock; never take TX below it.
+ * This gate is IRQ-safe and the protected operation must never sleep.
+ */
+int s5xxx_rfs_session_tx_begin(struct s5xxx_rfs_session *s, u64 epoch,
+				 unsigned long *flags);
+void s5xxx_rfs_session_tx_end(struct s5xxx_rfs_session *s, unsigned long flags);
+#endif
diff --git a/drivers/net/wwan/s5xxx_rfs_session_test.c b/drivers/net/wwan/s5xxx_rfs_session_test.c
new file mode 100644
index 000000000..bdc2676e8
--- /dev/null
+++ b/drivers/net/wwan/s5xxx_rfs_session_test.c
@@ -0,0 +1,362 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <kunit/test.h>
+#include <linux/completion.h>
+#include <linux/err.h>
+#include <linux/kthread.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+#include "s5xxx_rfs_session.h"
+
+static void cleanup(void *data)
+{
+	s5xxx_rfs_session_shutdown(data);
+}
+
+static struct s5xxx_rfs_session *session(struct kunit *test)
+{
+	struct s5xxx_rfs_session *s;
+
+	s = kunit_kzalloc(test, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return NULL;
+	s5xxx_rfs_session_init(s);
+	if (kunit_add_action_or_reset(test, cleanup, s))
+		return NULL;
+	return s;
+}
+
+static struct sk_buff *frame(u16 token)
+{
+	struct sk_buff *skb = alloc_skb(8, GFP_KERNEL);
+	u8 *p;
+
+	if (!skb)
+		return NULL;
+	p = skb_put_zero(skb, 8);
+	put_unaligned_le16(3, p);
+	put_unaligned_le16(token, p + 2);
+	return skb;
+}
+
+static void exclusive_owner(struct kunit *test)
+{
+	struct s5xxx_rfs_session *s = session(test);
+	u64 first, second;
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &first), 0);
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_session_open(s, &second), -EBUSY);
+	s5xxx_rfs_session_close(s, first);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &second), 0);
+	KUNIT_EXPECT_NE(test, first, second);
+}
+
+static void preopen_fifo(struct kunit *test)
+{
+	struct s5xxx_rfs_session *s = session(test);
+	struct sk_buff *skb;
+	u64 epoch;
+	int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	for (i = 0; i < 8; i++)
+		KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_rx(s, frame(i)), 0);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &epoch), 0);
+	for (i = 0; i < 8; i++) {
+		skb = s5xxx_rfs_session_take(s, epoch, 4096);
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, skb);
+		KUNIT_EXPECT_EQ(test, get_unaligned_le16(skb->data + 2), i);
+		kfree_skb(skb);
+	}
+	KUNIT_EXPECT_PTR_EQ(test, s5xxx_rfs_session_take(s, epoch, 4096),
+			    ERR_PTR(-EAGAIN));
+}
+
+static void undersized_read_retains_record(struct kunit *test)
+{
+	struct s5xxx_rfs_session *s = session(test);
+	struct sk_buff *skb;
+	u64 epoch;
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &epoch), 0);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_rx(s, frame(4)), 0);
+	KUNIT_EXPECT_PTR_EQ(test, s5xxx_rfs_session_take(s, epoch, 7),
+			    ERR_PTR(-EMSGSIZE));
+	skb = s5xxx_rfs_session_take(s, epoch, 8);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, skb);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(skb->data + 2), 4);
+	kfree_skb(skb);
+}
+
+static void reset_fences_old_fd_and_preserves_new_requests(struct kunit *test)
+{
+	struct s5xxx_rfs_session *s = session(test);
+	struct sk_buff *skb;
+	unsigned long flags;
+	u64 old, next;
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &old), 0);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_rx(s, frame(1)), 0);
+	s5xxx_rfs_session_reset(s);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_rx(s, frame(2)), 0);
+	KUNIT_EXPECT_PTR_EQ(test, s5xxx_rfs_session_take(s, old, 4096),
+			    ERR_PTR(-EPIPE));
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_session_tx_begin(s, old, &flags), -EPIPE);
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_session_open(s, &next), -EBUSY);
+	s5xxx_rfs_session_close(s, old);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &next), 0);
+	skb = s5xxx_rfs_session_take(s, next, 4096);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, skb);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(skb->data + 2), 2);
+	kfree_skb(skb);
+}
+
+static void stale_close_cannot_release_new_owner(struct kunit *test)
+{
+	struct s5xxx_rfs_session *s = session(test);
+	u64 old, next, competing;
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &old), 0);
+	s5xxx_rfs_session_close(s, old);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &next), 0);
+	s5xxx_rfs_session_close(s, old);
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_session_open(s, &competing), -EBUSY);
+}
+
+static void close_discards_unfinished_session_records(struct kunit *test)
+{
+	struct s5xxx_rfs_session *s = session(test);
+	u64 old, next;
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &old), 0);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_rx(s, frame(1)), 0);
+	s5xxx_rfs_session_close(s, old);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &next), 0);
+	KUNIT_EXPECT_PTR_EQ(test, s5xxx_rfs_session_take(s, next, 4096),
+			    ERR_PTR(-EAGAIN));
+}
+
+static void overflow_requires_explicit_reset(struct kunit *test)
+{
+	struct s5xxx_rfs_session *s = session(test);
+	u64 epoch;
+	int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	for (i = 0; i < S5XXX_RFS_RX_FRAMES; i++)
+		KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_rx(s, frame(i)), 0);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_rx(s, frame(99)), -ENOBUFS);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&s->rxq), 0);
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_session_open(s, &epoch), -EIO);
+	s5xxx_rfs_session_reset(s);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &epoch), 0);
+	KUNIT_EXPECT_PTR_EQ(test, s5xxx_rfs_session_take(s, epoch, 4096),
+			    ERR_PTR(-EAGAIN));
+}
+
+static void rx_allocation_failure_revokes_session(struct kunit *test)
+{
+	struct s5xxx_rfs_session *s = session(test);
+	u64 epoch;
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &epoch), 0);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_rx(s, NULL), -ENOMEM);
+	KUNIT_EXPECT_PTR_EQ(test, s5xxx_rfs_session_take(s, epoch, 4096),
+			    ERR_PTR(-EPIPE));
+	s5xxx_rfs_session_close(s, epoch);
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_session_open(s, &epoch), -EIO);
+}
+
+static void malformed_record_revokes_session(struct kunit *test)
+{
+	struct s5xxx_rfs_session *s = session(test);
+	struct sk_buff *skb = frame(1);
+	u64 epoch;
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &epoch), 0);
+	put_unaligned_le32(1, skb->data + 4);
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_session_rx(s, skb), -EPROTO);
+	KUNIT_EXPECT_PTR_EQ(test, s5xxx_rfs_session_take(s, epoch, 4096),
+			    ERR_PTR(-EPIPE));
+}
+
+static void frame_bounds_are_checked_before_header_access(struct kunit *test)
+{
+	u8 *data = kunit_kzalloc(test, 4097, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	KUNIT_EXPECT_FALSE(test, s5xxx_rfs_frame_valid(NULL, 8));
+	KUNIT_EXPECT_FALSE(test, s5xxx_rfs_frame_valid(data, 7));
+	KUNIT_EXPECT_TRUE(test, s5xxx_rfs_frame_valid(data, 8));
+	put_unaligned_le32(4088, data + 4);
+	KUNIT_EXPECT_TRUE(test, s5xxx_rfs_frame_valid(data, 4096));
+	KUNIT_EXPECT_FALSE(test, s5xxx_rfs_frame_valid(data, 4097));
+	put_unaligned_le32(U32_MAX, data + 4);
+	KUNIT_EXPECT_FALSE(test, s5xxx_rfs_frame_valid(data, 4096));
+}
+
+static void shutdown_is_permanent_and_wakes_pollers(struct kunit *test)
+{
+	struct s5xxx_rfs_session *s = session(test);
+	u64 epoch, next;
+	unsigned long flags;
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &epoch), 0);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_rx(s, frame(1)), 0);
+	s5xxx_rfs_session_shutdown(s);
+	KUNIT_EXPECT_PTR_EQ(test, s5xxx_rfs_session_take(s, epoch, 4096),
+			    ERR_PTR(-ENODEV));
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_session_tx_begin(s, epoch, &flags), -ENODEV);
+	KUNIT_EXPECT_TRUE(test, !!(s5xxx_rfs_session_poll(s, epoch) & EPOLLHUP));
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_session_rx(s, frame(2)), -ENODEV);
+	s5xxx_rfs_session_reset(s);
+	s5xxx_rfs_session_close(s, epoch);
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_session_open(s, &next), -ENODEV);
+}
+
+static void epoch_exhaustion_fails_closed(struct kunit *test)
+{
+	struct s5xxx_rfs_session *s = session(test);
+	unsigned long flags;
+	u64 epoch, next;
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	spin_lock_irqsave(&s->rxq.lock, flags);
+	s->epoch = U64_MAX;
+	spin_unlock_irqrestore(&s->rxq.lock, flags);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &epoch), 0);
+	s5xxx_rfs_session_reset(s);
+	s5xxx_rfs_session_close(s, epoch);
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_session_open(s, &next), -ENODEV);
+}
+
+static void tx_gate_accepts_only_the_live_owner(struct kunit *test)
+{
+	struct s5xxx_rfs_session *s = session(test);
+	unsigned long flags;
+	u64 epoch;
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &epoch), 0);
+	ret = s5xxx_rfs_session_tx_begin(s, epoch, &flags);
+	if (!ret)
+		s5xxx_rfs_session_tx_end(s, flags);
+	KUNIT_EXPECT_EQ(test, ret, 0);
+	s5xxx_rfs_session_close(s, epoch);
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_session_tx_begin(s, epoch, &flags), -EPIPE);
+}
+
+struct waiter {
+	struct s5xxx_rfs_session *s;
+	u64 epoch;
+	struct completion ready;
+	struct completion woke;
+	__poll_t mask;
+};
+
+static int wait_task(void *data)
+{
+	struct waiter *w = data;
+	DEFINE_WAIT(wait);
+	bool announced = false;
+
+	for (;;) {
+		int ret = prepare_to_wait_event(&w->s->wait, &wait,
+					       TASK_INTERRUPTIBLE);
+
+		if (!announced) {
+			announced = true;
+			complete(&w->ready);
+		}
+		if (ret || kthread_should_stop() ||
+		    (s5xxx_rfs_session_poll(w->s, w->epoch) &
+		     (EPOLLIN | EPOLLERR | EPOLLHUP)))
+			break;
+		schedule();
+	}
+	finish_wait(&w->s->wait, &wait);
+	w->mask = s5xxx_rfs_session_poll(w->s, w->epoch);
+	complete(&w->woke);
+	/* Keep the task valid until the test joins it with kthread_stop(). */
+	set_current_state(TASK_INTERRUPTIBLE);
+	while (!kthread_should_stop()) {
+		schedule();
+		set_current_state(TASK_INTERRUPTIBLE);
+	}
+	__set_current_state(TASK_RUNNING);
+	return 0;
+}
+
+static void reset_wakes_a_blocked_reader(struct kunit *test)
+{
+	struct s5xxx_rfs_session *s = session(test);
+	struct task_struct *task;
+	struct waiter w = { .s = s };
+	unsigned long woke;
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &w.epoch), 0);
+	init_completion(&w.ready);
+	init_completion(&w.woke);
+	task = kthread_run(wait_task, &w, "rfs-kunit-wait");
+	KUNIT_ASSERT_FALSE(test, IS_ERR(task));
+	wait_for_completion(&w.ready);
+	s5xxx_rfs_session_reset(s);
+	woke = wait_for_completion_timeout(&w.woke, HZ);
+	kthread_stop(task);
+	KUNIT_EXPECT_NE(test, woke, 0);
+	KUNIT_EXPECT_TRUE(test, !!(w.mask & EPOLLERR));
+}
+
+static void factory_open_extension_is_not_accepted_as_incoming(struct kunit *test)
+{
+	struct s5xxx_rfs_session *s = session(test);
+	const u8 golden[] = { 3, 0, 0x34, 0x12, 8, 0, 0, 0,
+			      0, 0, 0, 0, 40, 0, 0, 0, 1, 8, 0, 0 };
+	struct sk_buff *skb = alloc_skb(sizeof(golden), GFP_KERNEL);
+	u64 epoch;
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_ASSERT_EQ(test, s5xxx_rfs_session_open(s, &epoch), 0);
+	skb_put_data(skb, golden, sizeof(golden));
+	KUNIT_EXPECT_FALSE(test, s5xxx_rfs_frame_valid(golden, sizeof(golden)));
+	KUNIT_EXPECT_EQ(test, s5xxx_rfs_session_rx(s, skb), -EPROTO);
+	KUNIT_EXPECT_PTR_EQ(test, s5xxx_rfs_session_take(s, epoch, 4096),
+			    ERR_PTR(-EPIPE));
+}
+
+static struct kunit_case rfs_cases[] = {
+	KUNIT_CASE(factory_open_extension_is_not_accepted_as_incoming),
+	KUNIT_CASE(exclusive_owner),
+	KUNIT_CASE(preopen_fifo),
+	KUNIT_CASE(undersized_read_retains_record),
+	KUNIT_CASE(reset_fences_old_fd_and_preserves_new_requests),
+	KUNIT_CASE(stale_close_cannot_release_new_owner),
+	KUNIT_CASE(close_discards_unfinished_session_records),
+	KUNIT_CASE(overflow_requires_explicit_reset),
+	KUNIT_CASE(rx_allocation_failure_revokes_session),
+	KUNIT_CASE(malformed_record_revokes_session),
+	KUNIT_CASE(frame_bounds_are_checked_before_header_access),
+	KUNIT_CASE(shutdown_is_permanent_and_wakes_pollers),
+	KUNIT_CASE(epoch_exhaustion_fails_closed),
+	KUNIT_CASE(tx_gate_accepts_only_the_live_owner),
+	KUNIT_CASE(reset_wakes_a_blocked_reader),
+	{}
+};
+
+static struct kunit_suite rfs_suite = {
+	.name = "s5xxx-rfs-session",
+	.test_cases = rfs_cases,
+};
+kunit_test_suite(rfs_suite);
+MODULE_LICENSE("GPL");
diff --git a/drivers/of/of_reserved_mem.c b/drivers/of/of_reserved_mem.c
index 8c9d6395d..cdfec41ca 100644
--- a/drivers/of/of_reserved_mem.c
+++ b/drivers/of/of_reserved_mem.c
@@ -32,6 +32,33 @@ static struct reserved_mem *reserved_mem __refdata = reserved_mem_array;
 static int total_reserved_mem_cnt = MAX_RESERVED_REGIONS;
 static int reserved_mem_count;
 
+#ifdef CONFIG_LUMA_TOKAY_EMBEDDED_DIAGNOSTIC
+/* The embedded FDT is in init memory. The copied OF tree does not relocate
+ * these descriptor names. Run after normal allocation is available, before
+ * device initcalls consume the table and before init memory is freed.
+ */
+static int __init luma_preserve_reserved_mem_names(void)
+{
+	int i, copied = 0;
+
+	for (i = 0; i < reserved_mem_count; i++) {
+		const char *name = reserved_mem[i].name;
+		char *copy;
+
+		if (!name)
+			continue;
+		copy = kstrdup(name, GFP_KERNEL);
+		if (!copy)
+			panic("Cannot preserve embedded FDT reservation name");
+		reserved_mem[i].name = copy;
+		copied++;
+	}
+	pr_info("Luma lab: preserved %d reserved-memory names\n", copied);
+	return 0;
+}
+early_initcall(luma_preserve_reserved_mem_names);
+#endif
