+#define ISPFE_LMP_GATE_CDAF		BIT(1)
+#define ISPFE_LMP_GATE_PRE_LSC_AE	BIT(2)
+#define ISPFE_LMP_GATE_AWB_STATS	BIT(3)
+#define ISPFE_LMP_GATE_LSC_STATS	BIT(4)
