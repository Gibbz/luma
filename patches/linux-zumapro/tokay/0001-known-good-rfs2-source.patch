+struct exynos_ispfe_stats_ae_region {
+	__s32 sum[4];
+	__u16 usable_count[4];
+	__s32 y_diff_sum[4];
+	__u16 dark_count[4];
+	__s32 x_diff_sum[4];
+	__u16 saturated_count[4];
+	__u32 reserved[6];
