+static unsigned int get_etdm_wlen(snd_pcm_format_t format)
+{
+	unsigned int wlen = 0;
+
+	/* The reg_word_length should be >= reg_bit_length */
+	wlen = snd_pcm_format_physical_width(format);
+
+	if (wlen < 16)
