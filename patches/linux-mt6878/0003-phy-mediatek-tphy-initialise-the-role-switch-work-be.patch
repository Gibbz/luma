From e11a8c4af3db1cb52795b760b9f2ab1c4b939b41 Mon Sep 17 00:00:00 2001
From: Project Luma <builds@project-luma.local>
Date: Mon, 19 Oct 2026 00:44:07 -0400
Subject: [PATCH 03/12] phy: mediatek: tphy: initialise the role-switch work
 before using it

The delayed work was initialised after an early return and the retry path
fell through, scheduling an uninitialised work item.
---
 drivers/phy/mediatek/phy-mtk-tphy.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/phy/mediatek/phy-mtk-tphy.c b/drivers/phy/mediatek/phy-mtk-tphy.c
index e417e9e1e..e48761807 100644
--- a/drivers/phy/mediatek/phy-mtk-tphy.c
+++ b/drivers/phy/mediatek/phy-mtk-tphy.c
@@ -877,6 +877,7 @@ static void u2_phy_role_switch_work(struct work_struct *work)
 
 		instance->sw_get_retries += 1;
 		schedule_delayed_work(&instance->dr_work, msecs_to_jiffies(500));
+		return;
 	}
 
 	role = usb_role_switch_get_role(instance->role_switch);
@@ -897,6 +898,7 @@ static int u2_phy_software_role_switch_init(struct mtk_phy_instance *instance)
 	int mode;
 
 	instance->sw_get_retries = 0;
+	INIT_DELAYED_WORK(&instance->dr_work, u2_phy_role_switch_work);
 
 	ep = fwnode_graph_get_endpoint_by_id(dev_fwnode(&instance->phy->dev),
 					     0,
@@ -927,8 +929,6 @@ static int u2_phy_software_role_switch_init(struct mtk_phy_instance *instance)
 	else
 		u2_phy_instance_role_set(instance, USB_ROLE_DEVICE);
 
-	INIT_DELAYED_WORK(&instance->dr_work, u2_phy_role_switch_work);
-
 	return 0;
 }
 
