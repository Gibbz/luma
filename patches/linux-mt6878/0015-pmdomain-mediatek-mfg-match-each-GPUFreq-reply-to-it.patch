From 2fbfeb543261bfdffa69d0d22c5cc1ed05097091 Mon Sep 17 00:00:00 2001
From: Project Luma <builds@project-luma.local>
Date: Mon, 19 Oct 2026 13:00:00 -0400
Subject: [PATCH 15/17] pmdomain: mediatek: mfg: match each GPUFreq reply to
 its command

Re-arm the completion before every send so that a late reply to a timed
out command cannot complete the next one, and reject a reply whose
command differs from the one sent. Log which command timed out.
---
 drivers/pmdomain/mediatek/mtk-mfg-pmdomain.c | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/drivers/pmdomain/mediatek/mtk-mfg-pmdomain.c b/drivers/pmdomain/mediatek/mtk-mfg-pmdomain.c
index 9a8a38d98..7f3494b0a 100644
--- a/drivers/pmdomain/mediatek/mtk-mfg-pmdomain.c
+++ b/drivers/pmdomain/mediatek/mtk-mfg-pmdomain.c
@@ -453,11 +453,15 @@ static int mtk_mfg_eb_off(struct mtk_mfg *mfg)
 static int mtk_mfg_send_ipi(struct mtk_mfg *mfg, struct mtk_mfg_ipi_msg *msg)
 {
 	struct device *dev = &mfg->pdev->dev;
+	u32 cmd = le32_to_cpu(msg->cmd);
 	unsigned long wait;
 	int ret;
 
 	msg->magic = mfg->ipi_magic;
 
+	/* Forget a late reply to an earlier command that timed out. */
+	reinit_completion(&mfg->gf_mbox->rx_done);
+
 	ret = mbox_send_message(mfg->gf_mbox->ch, msg);
 	if (ret < 0) {
 		dev_err(dev, "Cannot send GPUFreq IPI command: %pe\n", ERR_PTR(ret));
@@ -465,11 +469,19 @@ static int mtk_mfg_send_ipi(struct mtk_mfg *mfg, struct mtk_mfg_ipi_msg *msg)
 	}
 
 	wait = wait_for_completion_timeout(&mfg->gf_mbox->rx_done, msecs_to_jiffies(500));
-	if (!wait)
+	if (!wait) {
+		dev_err(dev, "GPUFreq IPI command %u timed out\n", cmd);
 		return -ETIMEDOUT;
+	}
 
 	msg = mfg->gf_mbox->rx_data;
 
+	if (le32_to_cpu(msg->cmd) != cmd) {
+		dev_err(dev, "GPUFreq IPI reply for command %u, expected %u\n",
+			le32_to_cpu(msg->cmd), cmd);
+		return -EPROTO;
+	}
+
 	if (msg->u.return_value < 0) {
 		dev_err(dev, "IPI return: %d\n", msg->u.return_value);
 		return -EPROTO;
