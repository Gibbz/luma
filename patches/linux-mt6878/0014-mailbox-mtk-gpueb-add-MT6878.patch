From 01f3d007f09fe84b1ea9e1ba711724150402595b Mon Sep 17 00:00:00 2001
From: Project Luma <builds@project-luma.local>
Date: Mon, 19 Oct 2026 13:00:00 -0400
Subject: [PATCH 14/17] mailbox: mtk-gpueb: add MT6878

MT6878 has eleven GPUEB channels at a different layout and no separate
EB clock; make the clock optional.
---
 drivers/mailbox/mtk-gpueb-mailbox.c | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/drivers/mailbox/mtk-gpueb-mailbox.c b/drivers/mailbox/mtk-gpueb-mailbox.c
index 1b68c5f26..5fb3390a5 100644
--- a/drivers/mailbox/mtk-gpueb-mailbox.c
+++ b/drivers/mailbox/mtk-gpueb-mailbox.c
@@ -229,7 +229,7 @@ static int mtk_gpueb_mbox_probe(struct platform_device *pdev)
 	if (ebm->irq < 0)
 		return ebm->irq;
 
-	ebm->clk = devm_clk_get_prepared(ebm->dev, NULL);
+	ebm->clk = devm_clk_get_optional_prepared(ebm->dev, NULL);
 	if (IS_ERR(ebm->clk))
 		return dev_err_probe(ebm->dev, PTR_ERR(ebm->clk),
 				     "Failed to get 'eb' clock\n");
@@ -286,6 +286,23 @@ static int mtk_gpueb_mbox_probe(struct platform_device *pdev)
 	return devm_mbox_controller_register(ebm->dev, &ebm->mbox);
 }
 
+static const struct mtk_gpueb_mbox_variant mtk_gpueb_mbox_mt6878 = {
+	.num_channels = 11,
+	.channels = {
+		{ "fast-dvfs-event", 0, 0x0000, 16, 0x00d8, 16 },
+		{ "gpufreq",         1, 0x0010, 32, 0x00e8, 32 },
+		{ "sleep",           2, 0x0030, 12, 0x0108,  4 },
+		{ "timer",           3, 0x003c, 24, 0x010c,  4 },
+		{ "fhctl",           4, 0x0054, 36, 0x0110,  4 },
+		{ "ccf",             5, 0x0078, 16, 0x0114, 16 },
+		{ "gpumpu",          6, 0x0088, 24, 0x0124,  4 },
+		{ "fast-dvfs",       7, 0x00a0, 24, 0x0128, 24 },
+		{ "ipir-c-met",      8, 0x00b8,  4, 0x0140, 16 },
+		{ "ipis-c-met",      9, 0x00bc, 16, 0x0150,  4 },
+		{ "brisket",        10, 0x00cc, 12, 0x0154, 12 },
+	},
+};
+
 static const struct mtk_gpueb_mbox_variant mtk_gpueb_mbox_mt8196 = {
 	.num_channels = 12,
 	.channels = {
@@ -305,6 +322,7 @@ static const struct mtk_gpueb_mbox_variant mtk_gpueb_mbox_mt8196 = {
 };
 
 static const struct of_device_id mtk_gpueb_mbox_of_ids[] = {
+	{ .compatible = "mediatek,mt6878-gpueb-mbox", .data = &mtk_gpueb_mbox_mt6878 },
 	{ .compatible = "mediatek,mt8196-gpueb-mbox", .data = &mtk_gpueb_mbox_mt8196 },
 	{ /* Sentinel */ }
 };
