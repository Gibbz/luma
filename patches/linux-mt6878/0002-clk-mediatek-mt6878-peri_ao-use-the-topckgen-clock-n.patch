 	GATE_PERI_AO0(CLK_PERAOP_SPI5_B, "peraop_spi5_b",
-			"top_spi5_ck"/* parent */, 17),
+			"spi5_ck"/* parent */, 17),
 	GATE_PERI_AO0(CLK_PERAOP_SPI6_B, "peraop_spi6_b",
-			"top_spi6_ck"/* parent */, 18),
+			"spi6_ck"/* parent */, 18),
 	GATE_PERI_AO0(CLK_PERAOP_SPI7_B, "peraop_spi7_b",
-			"top_spi7_ck"/* parent */, 19),
+			"spi7_ck"/* parent */, 19),
