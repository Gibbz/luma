From 992122099f6eadb4a47445434d4eb79c05744d4e Mon Sep 17 00:00:00 2001
From: Project Luma <builds@project-luma.local>
Date: Mon, 19 Oct 2026 00:44:06 -0400
Subject: [PATCH 02/12] clk: mediatek: mt6878-peri_ao: use the topckgen clock
 names as parents

The gates named their parents "top_*_ck" while topckgen registers "*_ck",
leaving every gate orphaned at rate 0 (SPI then ran at its fastest
divider).
---
 drivers/clk/mediatek/clk-mt6878-peri_ao.c | 60 +++++++++++------------
 1 file changed, 30 insertions(+), 30 deletions(-)

diff --git a/drivers/clk/mediatek/clk-mt6878-peri_ao.c b/drivers/clk/mediatek/clk-mt6878-peri_ao.c
index 7ca9cf90f..628dc92bc 100644
--- a/drivers/clk/mediatek/clk-mt6878-peri_ao.c
+++ b/drivers/clk/mediatek/clk-mt6878-peri_ao.c
@@ -65,69 +65,69 @@ static const struct mtk_gate_regs peri_ao2_cg_regs = {
 static const struct mtk_gate peri_ao_clks[] = {
 	/* PERAO0 */
 	GATE_PERI_AO0(CLK_PERAOP_UART0, "peraop_uart0",
-			"top_uart_ck"/* parent */, 0),
+			"uart_ck"/* parent */, 0),
 	GATE_PERI_AO0(CLK_PERAOP_UART1, "peraop_uart1",
-			"top_uart_ck"/* parent */, 1),
+			"uart_ck"/* parent */, 1),
 	GATE_PERI_AO0(CLK_PERAOP_UART2, "peraop_uart2",
-			"top_uart_ck"/* parent */, 2),
+			"uart_ck"/* parent */, 2),
 	GATE_PERI_AO0(CLK_PERAOP_PWM_H, "peraop_pwm_h",
-			"top_axip_ck"/* parent */, 4),
+			"axip_ck"/* parent */, 4),
 	GATE_PERI_AO0(CLK_PERAOP_PWM_B, "peraop_pwm_b",
-			"top_pwm_ck"/* parent */, 5),
+			"pwm_ck"/* parent */, 5),
 	GATE_PERI_AO0(CLK_PERAOP_PWM_FB1, "peraop_pwm_fb1",
-			"top_pwm_ck"/* parent */, 6),
+			"pwm_ck"/* parent */, 6),
 	GATE_PERI_AO0(CLK_PERAOP_PWM_FB2, "peraop_pwm_fb2",
-			"top_pwm_ck"/* parent */, 7),
+			"pwm_ck"/* parent */, 7),
 	GATE_PERI_AO0(CLK_PERAOP_PWM_FB3, "peraop_pwm_fb3",
-			"top_pwm_ck"/* parent */, 8),
+			"pwm_ck"/* parent */, 8),
 	GATE_PERI_AO0(CLK_PERAOP_PWM_FB4, "peraop_pwm_fb4",
