 	/* PERAO1 */
 	GATE_PERI_AO1(CLK_PERAOP_SSUSB0_FRMCNT, "peraop_ssusb0_frmcnt",
 			"da_univ_48m_div_ck"/* parent */, 1),
 	GATE_PERI_AO1(CLK_PERAOP_MSDC0, "peraop_msdc0",
