+    fn write_request(token: u16, length: u32) -> Vec<u8> {
+        frame(
+            RFS_IO_REQUEST,
+            token,
+            &[
+                1u32.to_le_bytes(),
+                0u32.to_le_bytes(),
+                length.to_le_bytes(),
+                IO_WRITE.to_le_bytes(),
+            ]
+            .concat(),
+        )
+    }
+
+    fn write_chunk(token: u16, declared: u32, bytes: &[u8]) -> Vec<u8> {
+        let mut body = [
+            0u32.to_le_bytes(),
+            1u32.to_le_bytes(),
+            declared.to_le_bytes(),
+        ]
+        .concat();
+        body.extend(bytes);
+        frame(RFS_WRITE, token, &body)
+    }
+
+    fn error_response(token: u16, status: u32) -> Vec<u8> {
+        frame(
+            RFS_OP_STATUS,
+            token,
+            &[status.to_le_bytes(), 1u32.to_le_bytes()].concat(),
+        )
+    }
+
+    #[test]
+    fn unavailable_write_storage_returns_failure_without_success_ack() {
+        let root = std::env::temp_dir().join(format!("rfs-no-storage-{}", std::process::id()));
+        std::fs::write(&root, b"blocker").unwrap();
+        let device = root.with_extension("dev");
+        let mut rfs = Rfs::new(
+            File::create(&device).unwrap(),
+            Store::new(root.clone()),
+            false,
+        );
+        rfs.handle(&write_request(7, 4));
+        assert_eq!(
+            std::fs::read(&device).unwrap(),
+            error_response(7, RFS_STATUS_WRITE_FAILED)
+        );
+        assert_eq!(std::fs::read(&root).unwrap(), b"blocker");
+        std::fs::remove_file(root).unwrap();
+        std::fs::remove_file(device).unwrap();
+    }
+
+    #[test]
+    fn commit_failure_returns_failure_without_success_ack() {
+        let root = std::env::temp_dir().join(format!("rfs-commit-failure-{}", std::process::id()));
+        std::fs::create_dir_all(root.join("efs/nv_normal.bin")).unwrap();
+        let device = root.with_extension("dev");
+        let mut rfs = Rfs::new(
+            File::create(&device).unwrap(),
+            Store::new(root.clone()),
+            false,
+        );
+        rfs.handle(&write_request(7, 4));
+        let request_bytes = std::fs::metadata(&device).unwrap().len() as usize;
+        rfs.handle(&write_chunk(7, 4, b"NVNV"));
+        assert_eq!(
+            &std::fs::read(&device).unwrap()[request_bytes..],
+            error_response(7, RFS_STATUS_WRITE_FAILED)
+        );
+        assert!(root.join("efs/nv_normal.bin").is_dir());
+        std::fs::remove_dir_all(root).unwrap();
+        std::fs::remove_file(device).unwrap();
+    }
+
+    #[test]
+    fn invalid_chunks_preserve_committed_state() {
+        for (case, token, declared, bytes) in [
+            ("truncated", 7, 4, &b"NV"[..]),
+            ("oversized", 7, 5, &b"NVNVN"[..]),
+            ("stale-token", 8, 4, &b"NVNV"[..]),
+        ] {
+            let root =
+                std::env::temp_dir().join(format!("rfs-invalid-{}-{}", std::process::id(), case));
+            std::fs::create_dir_all(root.join("efs")).unwrap();
+            std::fs::write(root.join("efs/nv_normal.bin"), b"original").unwrap();
+            let device = root.with_extension("dev");
+            let mut rfs = Rfs::new(
+                File::create(&device).unwrap(),
+                Store::new(root.clone()),
+                false,
+            );
+            rfs.handle(&write_request(7, 4));
+            let request_bytes = std::fs::metadata(&device).unwrap().len() as usize;
+            rfs.handle(&write_chunk(token, declared, bytes));
+            assert_eq!(
+                &std::fs::read(&device).unwrap()[request_bytes..],
+                error_response(token, RFS_STATUS_INVALID_TRANSFER)
+            );
+            assert_eq!(
+                std::fs::read(root.join("efs/nv_normal.bin")).unwrap(),
+                b"original"
+            );
+            std::fs::remove_dir_all(root).unwrap();
+            std::fs::remove_file(device).unwrap();
+        }
+    }
