+    #[test]
+    fn serve_exits_when_the_peer_cannot_receive_a_reply() {
+        use std::net::Shutdown;
+        use std::os::fd::OwnedFd;
+        use std::os::unix::net::UnixStream;
+        let root =
+            std::env::temp_dir().join(format!("rfs-reply-serve-exit-{}", std::process::id()));
+        let (local, mut peer) = UnixStream::pair().unwrap();
+        peer.shutdown(Shutdown::Read).unwrap();
+        let local: OwnedFd = local.into();
+        let rfs = Rfs::new(local.into(), Store::new(root), false);
+        let (done, completed) = std::sync::mpsc::channel();
+        let worker = std::thread::spawn(move || {
+            serve(rfs);
+            done.send(()).unwrap();
+        });
+        peer.write_all(&frame(RFS_CLOSE, 1, &1u32.to_le_bytes()))
+            .unwrap();
+        completed
+            .recv_timeout(Duration::from_secs(2))
+            .expect("failed reply must end session without waiting for another CP frame");
+        worker.join().unwrap();
+    }
