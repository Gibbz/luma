+    struct ScriptedWriter {
+        outcomes: std::collections::VecDeque<io::Result<usize>>,
+        calls: usize,
+    }
+
+    impl Write for ScriptedWriter {
+        fn write(&mut self, _: &[u8]) -> io::Result<usize> {
+            self.calls += 1;
+            self.outcomes
+                .pop_front()
+                .expect("unexpected second frame fragment")
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+
+    #[test]
+    fn interrupted_frame_write_retries_the_whole_record() {
+        let mut writer = ScriptedWriter {
+            outcomes: [Err(io::ErrorKind::Interrupted.into()), Ok(8)].into(),
+            calls: 0,
+        };
+        write_frame(&mut writer, b"complete").unwrap();
+        assert_eq!(writer.calls, 2);
+    }
+
+    #[test]
+    fn a_short_frame_write_never_sends_the_tail_as_another_record() {
+        let mut writer = ScriptedWriter {
+            outcomes: [Ok(3)].into(),
+            calls: 0,
+        };
+        assert_eq!(
+            write_frame(&mut writer, b"complete").unwrap_err().kind(),
+            io::ErrorKind::InvalidData
+        );
+        assert_eq!(writer.calls, 1);
+    }
