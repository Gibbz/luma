+    #[test]
+    fn a_failed_reply_poisons_the_session_and_retains_the_first_error() {
+        let (mut rfs, root) = failed_transport_fixture("poison");
+        assert!(!rfs.send(b"first"));
+        let error = rfs.tx_error.as_ref().unwrap().raw_os_error();
+        assert!(!rfs.send(b"second"));
+        rfs.handle(&frame(
+            RFS_IO_REQUEST,
