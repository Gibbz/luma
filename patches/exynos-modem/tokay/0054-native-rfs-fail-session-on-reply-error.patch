+/// A WWAN write is one protocol frame. Never retry a short tail as a new
+/// frame, or spin on WouldBlock when the low-level port cannot accept it.
+fn write_frame(writer: &mut impl Write, frame: &[u8]) -> io::Result<()> {
+    loop {
+        match writer.write(frame) {
+            Ok(n) if n == frame.len() => return Ok(()),
+            Ok(0) => {
+                return Err(io::Error::new(
+                    io::ErrorKind::WriteZero,
+                    "RFS frame write made no progress",
+                ))
+            }
+            Ok(_) => {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "RFS frame was only partially written",
+                ))
+            }
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+            Err(error) => return Err(error),
+        }
+    }
+}
