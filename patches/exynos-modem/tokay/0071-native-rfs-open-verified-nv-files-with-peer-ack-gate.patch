+
+    fn factory_nv_open_frame(fid: u32, token: u16, name: &[u8]) -> Vec<u8> {
+        let mut body = [fid.to_le_bytes(), (name.len() as u32).to_le_bytes()].concat();
+        body.extend(name);
+        frame(RFS_OPEN, token, &body)
+    }
+
+    fn factory_nv_open_ack(fid: u32, token: u16, status: u32) -> Vec<u8> {
+        frame(
+            RFS_OP_STATUS,
+            token,
+            &[status.to_le_bytes(), fid.to_le_bytes()].concat(),
+        )
+    }
+
+    fn factory_nv_open_success(f: &mut FactoryNvFixture, fid: u32, name: &[u8]) {
+        let start = std::fs::metadata(&f.device).unwrap().len() as usize;
+        f.rfs.handle(&factory_nv_open_frame(fid, 0x1234, name));
+        assert_eq!(
+            &std::fs::read(&f.device).unwrap()[start..],
+            frame(
+                RFS_OP_STATUS,
+                0x1234,
+                &[0u32.to_le_bytes(), fid.to_le_bytes(), 64u32.to_le_bytes()].concat()
+            )
+        );
+    }
+
+    fn factory_nv_open_read_request(f: &mut FactoryNvFixture, fid: u32) -> Vec<u8> {
+        let start = std::fs::metadata(&f.device).unwrap().len() as usize;
+        f.rfs.handle(&frame(
+            RFS_IO_REQUEST,
+            0x5678,
+            &[
+                fid.to_le_bytes(),
+                0u32.to_le_bytes(),
+                4u32.to_le_bytes(),
+                IO_READ.to_le_bytes(),
+            ]
+            .concat(),
+        ));
+        std::fs::read(&f.device).unwrap()[start..].to_vec()
+    }
+
+    fn factory_nv_open_read_response(fid: u32, byte: u8) -> Vec<u8> {
+        let mut body = [fid.to_le_bytes(), 0u32.to_le_bytes(), 4u32.to_le_bytes()].concat();
+        body.extend([byte; 4]);
+        frame(RFS_READ, 0x5678, &body)
+    }
+
+    #[test]
+    fn factory_nv_open_all_reserved_names_return_verified_size_and_read() {
+        for (fid, name, byte, label) in [
+            (1, "nv_normal.bin", b'N', "open-normal"),
+            (2, "nv_user.bin", b'U', "open-user"),
+            (3, "nv_protected.bin", b'P', "open-protected"),
+        ] {
+            let mut f = FactoryNvFixture::new(label);
+            factory_nv_open_success(&mut f, fid, name.as_bytes());
+            f.rfs.handle(&factory_nv_open_ack(fid, 0x1234, 0));
+            assert_eq!(
+                factory_nv_open_read_request(&mut f, fid),
+                factory_nv_open_read_response(fid, byte)
+            );
+        }
+    }
+
+    #[test]
+    fn factory_nv_open_accepts_ascii_case_and_terminal_nul() {
+        let mut f = FactoryNvFixture::new("open-case");
+        factory_nv_open_success(&mut f, 2, b"NV_USER.BIN\0");
+        f.rfs.handle(&factory_nv_open_ack(2, 0x1234, 0));
+        assert_eq!(
+            factory_nv_open_read_request(&mut f, 2),
+            factory_nv_open_read_response(2, b'U')
+        );
+    }
+
+    #[test]
+    fn factory_nv_open_cannot_alias_carrier_path_into_reserved_fid() {
+        let mut f = FactoryNvFixture::new("open-alias");
+        std::fs::create_dir(f.root.join("carrier")).unwrap();
+        std::fs::write(f.root.join("carrier/config"), b"carrier data").unwrap();
+        f.rfs.carrier_roots = vec![f.root.join("carrier")];
+        f.rfs.handle(&factory_nv_open_frame(
+            2,
+            0x1234,
+            b"/vendor/firmware/carrierconfig/config",
+        ));
+        assert_eq!(
+            std::fs::read(&f.device).unwrap(),
+            factory_nv_open_ack(2, 0x1234, RFS_STATUS_INVALID_TRANSFER)
+        );
+        assert!(f.rfs.files.is_empty());
+    }
+
+    #[test]
+    fn factory_nv_open_rejects_wrong_name_for_reserved_fid() {
+        let mut f = FactoryNvFixture::new("open-name-mismatch");
+        f.rfs
+            .handle(&factory_nv_open_frame(3, 0x1234, b"nv_user.bin"));
+        assert_eq!(
+            std::fs::read(&f.device).unwrap(),
+            factory_nv_open_ack(3, 0x1234, RFS_STATUS_INVALID_TRANSFER)
+        );
+        assert!(f.rfs.files.is_empty());
+    }
+
+    #[test]
+    fn factory_nv_open_blocks_io_until_matching_ack() {
+        let mut f = FactoryNvFixture::new("open-pending");
+        factory_nv_open_success(&mut f, 2, b"nv_user.bin");
+        assert_eq!(
+            factory_nv_open_read_request(&mut f, 2),
+            factory_nv_open_ack(2, 0x5678, RFS_STATUS_INVALID_TRANSFER)
+        );
+        f.rfs.handle(&factory_nv_open_ack(2, 0x1235, 0));
+        assert_eq!(
+            factory_nv_open_read_request(&mut f, 2),
+            factory_nv_open_ack(2, 0x5678, RFS_STATUS_INVALID_TRANSFER)
+        );
+        f.rfs.handle(&factory_nv_open_ack(3, 0x1234, 0));
+        assert_eq!(
+            factory_nv_open_read_request(&mut f, 2),
+            factory_nv_open_ack(2, 0x5678, RFS_STATUS_INVALID_TRANSFER)
+        );
+        f.rfs.handle(&factory_nv_open_ack(2, 0x1234, 0));
+        assert_eq!(
+            factory_nv_open_read_request(&mut f, 2),
+            factory_nv_open_read_response(2, b'U')
+        );
+    }
+
+    #[test]
+    fn factory_nv_open_failed_ack_discards_prepared_handle() {
+        let mut f = FactoryNvFixture::new("open-failed-ack");
+        factory_nv_open_success(&mut f, 3, b"nv_protected.bin");
+        f.rfs.handle(&factory_nv_open_ack(3, 0x1234, 1));
+        assert!(!f.rfs.files.contains_key(&3));
+        assert_eq!(
+            factory_nv_open_read_request(&mut f, 3),
+            factory_nv_open_read_response(3, b'P')
+        );
+    }
+
+    #[test]
+    fn factory_nv_open_pending_close_cannot_destroy_handle() {
+        let mut f = FactoryNvFixture::new("open-close");
+        factory_nv_open_success(&mut f, 1, b"nv_normal.bin");
+        let start = std::fs::metadata(&f.device).unwrap().len() as usize;
+        f.rfs.handle(&frame(RFS_CLOSE, 0x5678, &1u32.to_le_bytes()));
+        assert_eq!(
+            &std::fs::read(&f.device).unwrap()[start..],
+            factory_nv_open_ack(1, 0x5678, RFS_STATUS_INVALID_TRANSFER)
+        );
+        assert!(f.rfs.files.contains_key(&1));
+        f.rfs.handle(&factory_nv_open_ack(1, 0x1234, 0));
+        assert_eq!(
+            factory_nv_open_read_request(&mut f, 1),
+            factory_nv_open_read_response(1, b'N')
+        );
+    }
+
+    #[test]
+    fn factory_nv_open_invalid_seed_never_creates_usable_handle() {
+        let mut f = FactoryNvFixture::new("open-invalid-seed");
+        std::fs::write(f.root.join("efs/nv_user.bin.md5"), b"bad checksum").unwrap();
+        f.rfs
+            .handle(&factory_nv_open_frame(2, 0x1234, b"nv_user.bin"));
+        assert_eq!(
+            std::fs::read(&f.device).unwrap(),
+            factory_nv_open_ack(2, 0x1234, RFS_STATUS_OPEN_FAILED)
+        );
+        assert!(f.rfs.files.is_empty());
+    }
 }
