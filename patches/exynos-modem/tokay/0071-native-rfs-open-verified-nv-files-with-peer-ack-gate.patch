Subject: [PATCH] rfs: serve reserved NV OPEN names and wait for matching ACK

The exact CP41 factory dispatcher reserves IDs 1..3 for case-insensitive
NV basenames. Its NV OPEN handlers prepare descriptors and return the
20-byte success record, while pending command 4 waits for peer status.

Provenance: factory-rfs-nv-open-audit.json and the exact-factory protected
transition audit. Open only validated native/readonly seeds or generations;
prevent carrier aliases in reserved IDs. Block IO/CLOSE until a matching
fid/token ACK. Discard the prepared handle on matching failed status.

Seven targeted NV OPEN cases fail against the preceding daemon; a corrupt
seed rejection already passes. The full protection/backup lifecycle and
carrier OPEN/CLOSE confirmation state machine remain unimplemented. No
protected writes or physical modem qualification are added by this patch.

---
diff --git a/crates/exynos-modem/src/rfs.rs b/crates/exynos-modem/src/rfs.rs
--- a/crates/exynos-modem/src/rfs.rs
+++ b/crates/exynos-modem/src/rfs.rs
@@ -154,16 +154,17 @@
 
 #[derive(Default)]
 struct Fent {
-    nv_file: bool,          // only implicit NV handles may write state
-    fd: Option<File>,       // open file (read source)
-    wfd: Option<File>,      // tmpfs write sink
-    size: i64,              // file size reported at OPEN
-    roff: i64,              // read cursor
+    nv_file: bool, // only verified implicit/explicit NV handles may write state
+    pending_nv_open: Option<u16>, // explicit NV OPEN awaits this CP acknowledgement
+    fd: Option<File>, // open file (read source)
+    wfd: Option<File>, // tmpfs write sink
+    size: i64,     // file size reported at OPEN
+    roff: i64,     // read cursor
     read_ack_pending: bool, // a successfully sent chunk still awaits peer status
-    rremain: i64,           // bytes left to serve for the active read
-    woff: i64,              // write cursor
-    wremain: i64,           // bytes left to sink for the active write
-    token: u16,             // active IO_REQUEST token, echoed in chunks
+    rremain: i64,  // bytes left to serve for the active read
+    woff: i64,     // write cursor
+    wremain: i64,  // bytes left to sink for the active write
+    token: u16,    // active IO_REQUEST token, echoed in chunks
 }
 
 struct Rfs {
@@ -348,6 +349,33 @@
                 let plen = le32(&f[0xc..]) as usize;
                 if self.files.contains_key(&fid) || plen == 0 || plen > n - 0x10 {
                     self.op_result(token, fid, RFS_STATUS_INVALID_TRANSFER);
+                    return;
+                }
+                if let Some(expected_name) = nv_name(fid) {
+                    // The factory root dispatcher reserves IDs 1..3 and
+                    // checks their basenames with strcasecmp (0xa1bc..0xa1e4).
+                    let requested = &f[0x10..0x10 + plen];
+                    let requested = requested.strip_suffix(&[0u8][..]).unwrap_or(requested);
+                    if !requested.eq_ignore_ascii_case(expected_name.as_bytes()) {
+                        self.op_result(token, fid, RFS_STATUS_INVALID_TRANSFER);
+                        return;
+                    }
+                    self.open_nv(fid);
+                    let size = self.files[&fid]
+                        .fd
+                        .as_ref()
+                        .and_then(|file| file.metadata().ok())
+                        .map(|metadata| metadata.len())
+                        .filter(|size| *size > 0 && *size <= u32::MAX as u64);
+                    let Some(size) = size else {
+                        self.files.remove(&fid);
+                        self.op_result(token, fid, RFS_STATUS_OPEN_FAILED);
+                        return;
+                    };
+                    self.files.get_mut(&fid).unwrap().pending_nv_open = Some(token);
+                    // Preparing a verified descriptor does not complete OPEN:
+                    // factory pending command 4 commits after the peer status.
+                    self.open_status(token, fid, size as u32);
                     return;
                 }
                 let src = std::str::from_utf8(&f[0x10..0x10 + plen])
@@ -413,6 +441,10 @@
                 // IO_REQUEST makes the CP wait/time out and can stall its IPC
                 // (seen blocking the SIT control channel).
                 if !self.files.contains_key(&fid) {
+                    self.op_result(token, fid, RFS_STATUS_INVALID_TRANSFER);
+                    return;
+                }
+                if self.files[&fid].pending_nv_open.is_some() {
                     self.op_result(token, fid, RFS_STATUS_INVALID_TRANSFER);
                     return;
                 }
@@ -640,10 +672,35 @@
                     return;
                 }
                 let fid = le32(&f[8..]);
+                if self
+                    .files
+                    .get(&fid)
+                    .is_some_and(|entry| entry.pending_nv_open.is_some())
+                {
+                    self.op_result(token, fid, RFS_STATUS_INVALID_TRANSFER);
+                    return;
+                }
                 self.files.remove(&fid);
                 self.op_status(token, fid);
             }
-            RFS_OP_STATUS => {} // 3: modem ack -- consume
+            RFS_OP_STATUS => {
+                if n < 0x10 {
+                    return;
+                }
+                let fid = le32(&f[0xc..]);
+                let Some(entry) = self.files.get_mut(&fid) else {
+                    return;
+                };
+                if entry.pending_nv_open != Some(token) {
+                    return;
+                }
+                entry.pending_nv_open = None;
+                if le32(&f[8..]) != 0 {
+                    // Discard the prepared handle after a failed peer ACK.
+                    // A later implicit NV read must validate/reopen its seed.
+                    self.files.remove(&fid);
+                }
+            }
             _ => eprintln!("rfs: unknown cmd={}", cmd),
         }
     }
@@ -1191,7 +1248,7 @@
