+    fn range_write_request(token: u16, offset: u32, length: u32) -> Vec<u8> {
+        frame(
+            RFS_IO_REQUEST,
+            token,
+            &[
+                1u32.to_le_bytes(),
+                offset.to_le_bytes(),
+                length.to_le_bytes(),
+                IO_WRITE.to_le_bytes(),
+            ]
+            .concat(),
+        )
+    }
+
+    #[test]
+    fn range_writes_preserve_untouched_nv_bytes_and_refresh_reads() {
+        let root = std::env::temp_dir().join(format!("rfs-offset-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        std::fs::create_dir_all(root.join("efs")).unwrap();
+        let path = root.join("efs/nv_normal.bin");
+        std::fs::write(&path, b"abcdefghijkl").unwrap();
+        let device = root.with_extension("dev");
+        let mut rfs = Rfs::new(
+            File::create(&device).unwrap(),
+            Store::new(root.clone()),
+            false,
+        );
+        for (token, offset, data, expected) in [
+            (7u16, 4u32, &b"NVNV"[..], &b"abcdNVNVijkl"[..]),
+            (8, 0, &b"XY"[..], &b"XYcdNVNVijkl"[..]),
+            (9, 10, &b"ZZ"[..], &b"XYcdNVNVijZZ"[..]),
+        ] {
+            let start = std::fs::metadata(&device).unwrap().len() as usize;
+            rfs.handle(&range_write_request(token, offset, data.len() as u32));
+            let request = std::fs::read(&device).unwrap();
+            assert_eq!(le16(&request[start..]), RFS_WRITE);
+            assert_eq!(le32(&request[start + 12..]), offset);
+            assert_eq!(std::fs::read(&path).unwrap().len(), 12);
+            rfs.handle(&write_chunk(token, data.len() as u32, data));
+            assert_eq!(std::fs::read(&path).unwrap(), expected);
+            let e = rfs.files.get_mut(&1).unwrap();
+            assert_eq!(e.size, 12);
+            let mut fresh = Vec::new();
+            let fd = e.fd.as_mut().unwrap();
+            fd.seek(SeekFrom::Start(0)).unwrap();
+            fd.read_to_end(&mut fresh).unwrap();
+            assert_eq!(fresh, expected);
+        }
+        std::fs::remove_dir_all(root).unwrap();
+        std::fs::remove_file(device).unwrap();
+    }
+
+    #[test]
+    fn unsupported_or_out_of_bounds_ranges_fail_before_staging() {
+        for (tag, offset, length) in [
+            ("sentinel", u32::MAX, 1),
+            ("empty", 0, 0),
+            ("past-end", 7, 2),
+            ("overflow", u32::MAX - 1, 4),
+        ] {
+            let root =
+                std::env::temp_dir().join(format!("rfs-range-{}-{}", std::process::id(), tag));
+            let _ = std::fs::remove_dir_all(&root);
+            std::fs::create_dir_all(root.join("efs")).unwrap();
+            let path = root.join("efs/nv_normal.bin");
+            std::fs::write(&path, b"original").unwrap();
+            let device = root.with_extension("dev");
+            let mut rfs = Rfs::new(
+                File::create(&device).unwrap(),
+                Store::new(root.clone()),
+                false,
+            );
+            rfs.handle(&range_write_request(7, offset, length));
+            assert_eq!(
+                std::fs::read(&device).unwrap(),
+                error_response(7, RFS_STATUS_INVALID_TRANSFER)
+            );
+            assert_eq!(std::fs::read(&path).unwrap(), b"original");
+            assert!(!root.join("efs/nv_normal.bin.part").exists());
+            std::fs::remove_dir_all(root).unwrap();
+            std::fs::remove_file(device).unwrap();
+        }
+    }
+
+    #[test]
+    fn nv_staging_does_not_follow_a_symlink() {
+        let root = std::env::temp_dir().join(format!("rfs-stage-link-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        std::fs::create_dir_all(root.join("efs")).unwrap();
+        let target = root.join("target");
+        std::fs::write(&target, b"private").unwrap();
+        std::os::unix::fs::symlink(&target, root.join("efs/nv_normal.bin.part")).unwrap();
+        let device = root.with_extension("dev");
+        let mut rfs = Rfs::new(
+            File::create(&device).unwrap(),
+            Store::new(root.clone()),
+            false,
+        );
+        rfs.handle(&range_write_request(7, 0, 4));
+        assert_eq!(
+            std::fs::read(&device).unwrap(),
+            error_response(7, RFS_STATUS_WRITE_FAILED)
+        );
+        assert_eq!(std::fs::read(&target).unwrap(), b"private");
+        assert!(!root.join("efs/nv_normal.bin").exists());
+        std::fs::remove_dir_all(root).unwrap();
+        std::fs::remove_file(device).unwrap();
+    }
+
