+        std::fs::create_dir_all(root.join("carrier")).unwrap();
+        std::fs::write(root.join("carrier/config"), b"carrier data").unwrap();
+        let device = root.with_extension("dev");
+        let mut rfs = Rfs::new(
+            File::create(&device).unwrap(),
+            Store::new(root.clone()),
+            false,
+        );
+        rfs.carrier_roots = vec![root.join("carrier")];
+        let path = b"/vendor/firmware/carrierconfig/config";
+        let body = [
+            1u32.to_le_bytes().as_slice(),
+            (path.len() as u32).to_le_bytes().as_slice(),
+            path,
+        ]
+        .concat();
+        rfs.handle(&frame(RFS_OPEN, 1, &body));
+        let start = std::fs::metadata(&device).unwrap().len() as usize;
+        rfs.handle(&range_write_request(7, 0, 4));
+        assert_eq!(
