+        .into_iter()
+        .enumerate()
+        {
+            let (store, root, part) = fixture(&format!("fault-{i}"));
+            fs::write(&part, b"old state").unwrap();
+            store.commit(Kind::Efs, "nv_normal.bin").unwrap();
+            fs::write(&part, b"new state").unwrap();
+            assert!(
+                publish_with(&root.join("efs"), "nv_normal.bin", &part, |p| {
+                    if p == point {
+                        Err(io::Error::other("injected I/O boundary failure"))
