+//! Atomic native NV/checksum publication. Vendor partitions are never written.
+//! Old and orphan generations are retained; recovery/garbage collection and
+//! the protected-NV protocol still need qualification before deployment.
+
+use std::fs::{self, File, OpenOptions};
+use std::io::{self, Read, Seek, SeekFrom, Write};
+use std::os::unix::fs::{DirBuilderExt, MetadataExt, OpenOptionsExt};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+const SALT: &[u8] = b"Samsung_SIT_RIL";
+static NEXT: AtomicU64 = AtomicU64::new(1);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Point {
+    DataCopied,
+    DataSynced,
+    SidecarSynced,
+    GenerationSynced,
+    PointerSynced,
+    PointerRenamed,
+    DirectorySynced,
+}
+
+fn known_name(name: &str) -> bool {
+    matches!(name, "nv_normal.bin" | "nv_protected.bin" | "nv_user.bin")
+}
+
+fn invalid(message: &'static str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, message)
+}
+
+fn regular(path: &Path) -> io::Result<File> {
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(path)?;
+    if !file.metadata()?.is_file() {
+        return Err(invalid("NV state is not a regular file"));
+    }
+    Ok(file)
+}
+
+fn private_regular(path: &Path) -> io::Result<File> {
+    let file = regular(path)?;
+    let metadata = file.metadata()?;
+    if metadata.uid() != unsafe { libc::geteuid() } || metadata.mode() & 0o077 != 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "NV generation file is not private and owned",
+        ));
+    }
+    Ok(file)
+}
+
+fn checksum(file: &mut File) -> io::Result<String> {
+    file.seek(SeekFrom::Start(0))?;
+    let mut context = md5::Context::new();
+    let mut buffer = [0; 16384];
+    loop {
+        let n = file.read(&mut buffer)?;
+        if n == 0 {
+            break;
+        }
+        context.consume(&buffer[..n]);
+    }
+    context.consume(SALT);
+    Ok(format!("{:x}", context.finalize()))
+}
+
+/// None means never published. Every other failure must block legacy fallback.
+pub(super) fn read(directory: &Path, name: &str) -> io::Result<Option<PathBuf>> {
+    if !known_name(name) {
+        return Err(invalid("unknown NV filename"));
+    }
+    let pointer = directory.join(format!("{name}.current"));
+    match fs::symlink_metadata(&pointer) {
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error),
+        Ok(_) => {}
+    }
+    super::validate_state_dir(
+        directory
+            .parent()
+            .ok_or_else(|| invalid("missing state root"))?,
+    )?;
+    super::validate_state_dir(directory)?;
+    let pointer_file = private_regular(&pointer)?;
+    if pointer_file.metadata()?.len() > 192 {
+        return Err(invalid("oversized NV pointer"));
+    }
+    let mut target = String::new();
+    pointer_file.take(193).read_to_string(&mut target)?;
+    let target = target
+        .strip_suffix('\n')
+        .ok_or_else(|| invalid("invalid NV pointer"))?;
+    let suffix = target
+        .strip_prefix(&format!("{name}.gen-"))
+        .ok_or_else(|| invalid("wrong NV generation name"))?;
+    if suffix.is_empty() || !suffix.bytes().all(|b| b.is_ascii_hexdigit() || b == b'-') {
+        return Err(invalid("invalid NV generation component"));
+    }
+    let generation = directory.join(target);
+    super::validate_state_dir(&generation)?;
+    let data_path = generation.join("data.bin");
+    let mut data = private_regular(&data_path)?;
+    let mut sidecar = private_regular(&generation.join("data.md5"))?;
+    if sidecar.metadata()?.len() != 32 {
+        return Err(invalid("invalid NV checksum size"));
+    }
+    let mut expected = [0; 32];
+    sidecar.read_exact(&mut expected)?;
+    if !expected.iter().all(u8::is_ascii_hexdigit)
+        || !expected.eq_ignore_ascii_case(checksum(&mut data)?.as_bytes())
+    {
+        return Err(invalid("NV generation checksum mismatch"));
+    }
+    Ok(Some(data_path))
+}
+
+pub(super) fn publish(directory: &Path, name: &str, stage: &Path) -> io::Result<PathBuf> {
+    publish_with(directory, name, stage, |_| Ok(()))
+}
+
+fn publish_with(
+    directory: &Path,
+    name: &str,
+    stage: &Path,
+    mut checkpoint: impl FnMut(Point) -> io::Result<()>,
+) -> io::Result<PathBuf> {
+    // No protected write is supported without the complete factory protocol.
+    if name == "nv_protected.bin" {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "protected NV publication is unsupported",
+        ));
+    }
+    if !matches!(name, "nv_normal.bin" | "nv_user.bin") {
+        return Err(invalid("unknown writable NV filename"));
+    }
+    super::validate_state_dir(directory)?;
+    let _ = read(directory, name)?;
+    // Preserve existing non-regular legacy entries rather than replacing them.
+    match fs::symlink_metadata(directory.join(name)) {
+        Ok(m) if !m.is_file() => return Err(invalid("legacy NV path is not regular")),
+        Err(e) if e.kind() != io::ErrorKind::NotFound => return Err(e),
+        _ => {}
+    }
+    let mut source = regular(stage)?;
+    let source_size = source.metadata()?.len();
+    if source_size == 0 {
+        return Err(invalid("empty NV publication is invalid"));
+    }
+    let mut selected = None;
+    for _ in 0..128 {
+        let now = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map_err(io::Error::other)?
+            .as_nanos();
+        let component = format!(
+            "{name}.gen-{:x}-{:x}-{:x}",
+            std::process::id(),
+            now,
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        );
+        let path = directory.join(&component);
+        match fs::DirBuilder::new().mode(0o700).create(&path) {
+            Ok(()) => {
+                selected = Some((component, path));
+                break;
+            }
+            Err(e) if e.kind() == io::ErrorKind::AlreadyExists => continue,
+            Err(e) => return Err(e),
+        }
+    }
+    let (component, generation) = selected.ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            "cannot allocate unique NV generation",
+        )
+    })?;
+    File::open(directory)?.sync_all()?;
+    // Copy into an independent inode: an old staging FD cannot alter a
+    // published generation or its checksum after this operation completes.
+    let data_path = generation.join("data.bin");
+    let mut data = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(&data_path)?;
+    let copied = io::copy(&mut (&mut source).take(source_size), &mut data)?;
+    if copied != source_size {
+        return Err(invalid("NV stage truncated during publication"));
+    }
+    checkpoint(Point::DataCopied)?;
+    data.sync_all()?;
+    checkpoint(Point::DataSynced)?;
+    let digest = checksum(&mut data)?;
+    let mut sidecar = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(generation.join("data.md5"))?;
+    sidecar.write_all(digest.as_bytes())?;
+    sidecar.sync_all()?;
+    checkpoint(Point::SidecarSynced)?;
+    File::open(&generation)?.sync_all()?;
+    checkpoint(Point::GenerationSynced)?;
+    let temporary = directory.join(format!(".{component}.pointer.part"));
+    let mut pointer = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(&temporary)?;
+    writeln!(pointer, "{component}")?;
+    pointer.sync_all()?;
+    checkpoint(Point::PointerSynced)?;
+    fs::rename(&temporary, directory.join(format!("{name}.current")))?;
+    checkpoint(Point::PointerRenamed)?;
+    File::open(directory)?.sync_all()?;
+    checkpoint(Point::DirectorySynced)?;
+    // Publication has completed. An unlink failure is an error, not a claimed
+    // rollback: the new generation remains the current coherent read view.
+    fs::remove_file(stage)?;
+    File::open(directory)?.sync_all()?;
+    Ok(data_path)
+}
+
