+    #[test]
+    fn protected_and_unknown_nv_names_cannot_be_published() {
+        let (store, root, part) = fixture("protected");
+        fs::write(&part, b"fixture").unwrap();
+        for name in ["nv_protected.bin", "../escape", "unexpected.bin"] {
+            assert!(publish(&root.join("efs"), name, &part).is_err());
+        }
+        assert!(part.exists());
+        assert!(store.read_path(Kind::Efs, "nv_normal.bin").is_none());
+        fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn symlinked_generation_members_and_directories_are_rejected() {
+        for (i, member) in ["data.bin", "data.md5", "directory"]
+            .into_iter()
+            .enumerate()
+        {
+            let (store, root, part) = fixture(&format!("member-link-{i}"));
+            fs::write(&part, b"current").unwrap();
+            let data = store.commit(Kind::Efs, "nv_normal.bin").unwrap();
+            let generation = data.parent().unwrap();
+            let outside = root.join("outside");
+            if member == "directory" {
+                fs::rename(generation, &outside).unwrap();
+                symlink(&outside, generation).unwrap();
+            } else {
+                let target = generation.join(member);
+                fs::rename(&target, &outside).unwrap();
+                symlink(&outside, &target).unwrap();
+            }
+            assert!(store.read_path(Kind::Efs, "nv_normal.bin").is_none());
+            fs::remove_dir_all(root).unwrap();
+        }
+    }
+
+    #[test]
+    fn an_empty_stage_cannot_replace_an_existing_generation() {
+        let (store, root, part) = fixture("empty");
+        fs::write(&part, b"current").unwrap();
+        let current = store.commit(Kind::Efs, "nv_normal.bin").unwrap();
+        fs::write(&part, b"").unwrap();
+        assert!(store.commit(Kind::Efs, "nv_normal.bin").is_err());
+        assert_eq!(store.read_path(Kind::Efs, "nv_normal.bin"), Some(current));
+        fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn publication_crash_child() {
+        let Ok(root) = std::env::var("LUMA_NV_TEST_CRASH_ROOT") else {
+            return;
+        };
+        let root = PathBuf::from(root);
+        assert!(root.starts_with(std::env::temp_dir()));
+        assert!(root
+            .file_name()
+            .unwrap()
+            .to_string_lossy()
+            .starts_with("nv-generation-"));
+        let stage = root.join("efs/nv_normal.bin.part");
+        assert_eq!(fs::read(&stage).unwrap(), b"new state");
+        let wanted = std::env::var("LUMA_NV_TEST_CRASH_POINT").unwrap();
+        publish_with(&root.join("efs"), "nv_normal.bin", &stage, |point| {
+            if format!("{point:?}") == wanted {
+                unsafe { libc::_exit(77) };
+            }
+            Ok(())
+        })
+        .unwrap();
+        panic!("requested crash checkpoint was not reached");
+    }
+
+    #[test]
+    fn process_exit_at_each_checkpoint_leaves_only_a_complete_read_view() {
+        for (i, point) in [
+            Point::DataCopied,
+            Point::DataSynced,
+            Point::SidecarSynced,
+            Point::GenerationSynced,
+            Point::PointerSynced,
+            Point::PointerRenamed,
+            Point::DirectorySynced,
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            let (store, root, stage) = fixture(&format!("process-crash-{i}"));
+            fs::write(&stage, b"old state").unwrap();
+            store.commit(Kind::Efs, "nv_normal.bin").unwrap();
+            fs::write(&stage, b"new state").unwrap();
+            let executable = std::env::current_exe().unwrap();
+            let mut command = if cfg!(target_arch = "aarch64") {
+                if let Some(runner) =
+                    std::env::var_os("CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_RUNNER")
+                {
+                    let mut c = std::process::Command::new(runner);
+                    c.arg(&executable);
+                    c
+                } else {
+                    std::process::Command::new(&executable)
+                }
+            } else {
+                std::process::Command::new(&executable)
+            };
+            let result = command
+                .args([
+                    "--exact",
+                    "store::nv::tests::publication_crash_child",
+                    "--nocapture",
+                ])
+                .env("LUMA_NV_TEST_CRASH_ROOT", &root)
+                .env("LUMA_NV_TEST_CRASH_POINT", format!("{point:?}"))
+                .output()
+                .unwrap();
+            assert_eq!(
+                result.status.code(),
+                Some(77),
+                "{}",
+                String::from_utf8_lossy(&result.stderr)
+            );
+            let view = Store::new(root.clone())
+                .read_path(Kind::Efs, "nv_normal.bin")
+                .expect("fresh process sees coherent state");
+            let expected = if matches!(point, Point::PointerRenamed | Point::DirectorySynced) {
+                b"new state"
+            } else {
+                b"old state"
+            };
+            assert_eq!(fs::read(view).unwrap(), expected);
+            fs::remove_dir_all(root).unwrap();
+        }
+    }
