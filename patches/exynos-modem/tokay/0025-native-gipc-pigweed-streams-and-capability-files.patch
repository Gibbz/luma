+        )
+    }
+
+    #[test]
+    fn capability_stream_reassembles_exact_source_and_keeps_call_id() {
+        let root = fixture("reassemble");
+        let data: Vec<u8> = (0..10_037).map(|i| (i % 251) as u8).collect();
+        std::fs::write(root.join("lte_fixture.binarypb"), &data).unwrap();
+        let handler = Gipc::with_uecap_dir(root.clone(), false);
+        let replies = handler.handle(&read_request("lte_fixture.binarypb", 4000).encode_to_vec());
+        assert_eq!(replies.len(), 4);
+        let mut assembled = Vec::new();
+        for (i, reply) in replies.iter().enumerate() {
+            let packet = GipcMessage::decode(reply.as_slice()).unwrap();
+            assert_eq!(packet.sequence, Some(6));
+            assert_eq!(packet.endpoint, Some(132));
+            assert_eq!(packet.service, Some(SVC_UECAP));
+            assert_eq!(packet.method, Some(METHOD_READ));
+            assert_eq!(packet.status, None);
+            if i < 3 {
+                assert_eq!(packet.r#type, Some(TYPE_SERVER_STREAM));
+                let chunk = GipcUecapReadChunk::decode(packet.payload.unwrap().as_slice()).unwrap();
+                let bytes = chunk.data.unwrap();
+                assert!(bytes.len() <= 4000);
+                assembled.extend(bytes);
+            } else {
+                assert_eq!(packet.r#type, Some(TYPE_RESPONSE));
+                assert!(packet.payload.is_none());
+            }
+        }
+        assert_eq!(assembled, data);
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn firmware_paths_are_confined_and_links_are_rejected() {
+        let root = fixture("paths");
+        let handler = Gipc::with_uecap_dir(root.clone(), false);
+        std::fs::write(root.join("source"), b"fixture").unwrap();
+        std::os::unix::fs::symlink(root.join("source"), root.join("link")).unwrap();
+        for name in [
+            "../source",
+            "/etc/shadow",
+            "nested/source",
+            ".",
+            "..",
+            "link",
+            "",
+        ] {
+            let replies = handler.handle(&read_request(name, 4000).encode_to_vec());
+            assert_eq!(replies.len(), 1);
+            let response = GipcMessage::decode(replies[0].as_slice()).unwrap();
+            assert_eq!(response.r#type, Some(TYPE_SERVER_ERROR));
+            assert_eq!(response.status, Some(INVALID_ARGUMENT));
+        }
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn capability_errors_do_not_send_successful_empty_files() {
+        let root = fixture("errors");
+        let handler = Gipc::with_uecap_dir(root.clone(), false);
+        let missing = handler.handle(&read_request("missing", 4000).encode_to_vec());
+        assert_eq!(
+            GipcMessage::decode(missing[0].as_slice()).unwrap().status,
+            Some(NOT_FOUND)
+        );
+        for block in [0, 4001] {
+            let replies = handler.handle(&read_request("missing", block).encode_to_vec());
+            let response = GipcMessage::decode(replies[0].as_slice()).unwrap();
+            assert_eq!(response.r#type, Some(TYPE_SERVER_ERROR));
+            assert!(response.status.is_some());
+        }
+        let mut request = read_request("missing", 4000);
+        let mut payload =
+            GipcUecapReadRequest::decode(request.payload.unwrap().as_slice()).unwrap();
+        payload.preprocessing_payload = Some(vec![8, 1]);
+        request.payload = Some(payload.encode_to_vec());
+        let replies = handler.handle(&request.encode_to_vec());
+        assert_eq!(
+            GipcMessage::decode(replies[0].as_slice()).unwrap().status,
+            Some(UNIMPLEMENTED)
+        );
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn unsupported_services_return_pigweed_error_without_fake_ack() {
+        let handler = Gipc::new(false);
+        let replies =
+            handler.handle(&packet(TYPE_REQUEST, (0x1234, 0x5678), 42, None).encode_to_vec());
+        let response = GipcMessage::decode(replies[0].as_slice()).unwrap();
+        assert_eq!(response.r#type, Some(TYPE_SERVER_ERROR));
+        assert_eq!(response.status, Some(UNIMPLEMENTED));
+        assert_eq!(response.sequence, Some(42));
+    }
 }
