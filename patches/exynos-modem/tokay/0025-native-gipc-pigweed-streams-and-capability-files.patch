+// UecapFileService.Read request layout recovered from the factory's bounded
+// StreamDecoder MessageField table and handler at 0x302020. Field 3 is retained
+// opaquely; the observed factory handler uses size, block_size, file_name and
+// optional preprocessing payload. Filtering requests are not silently ignored.
+message GipcUecapReadRequest {
+  optional uint32 size = 1;
+  optional uint32 block_size = 2;
+  optional uint32 selector = 3;
+  optional string file_name = 4;
+  optional bytes preprocessing_payload = 5;
