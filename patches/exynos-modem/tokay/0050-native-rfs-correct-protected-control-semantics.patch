+    #[test]
+    fn unimplemented_protect_and_backup_controls_never_acknowledge_success() {
+        let root =
+            std::env::temp_dir().join(format!("rfs-protected-controls-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        let device = root.with_extension("dev");
+        let mut rfs = Rfs::new(
+            File::create(&device).unwrap(),
+            Store::new(root.clone()),
+            false,
+        );
+        for cmd in [
+            RFS_NV_UNPROTECT,
+            RFS_NV_PROTECT,
+            RFS_NV_BACKUP,
+            RFS_NV_BACKUP_AND_CNF,
+        ] {
+            let start = std::fs::metadata(&device).unwrap().len() as usize;
+            rfs.handle(&frame(cmd, 7, &2u32.to_le_bytes()));
+            assert_eq!(
+                &std::fs::read(&device).unwrap()[start..],
+                frame(
+                    RFS_OP_STATUS,
+                    7,
+                    &[
+                        RFS_STATUS_INVALID_TRANSFER.to_le_bytes(),
+                        2u32.to_le_bytes()
+                    ]
+                    .concat()
+                )
+            );
+            assert!(rfs.files.is_empty());
+            assert!(!root.exists());
+        }
+        std::fs::remove_file(device).unwrap();
+    }
+
+    #[test]
+    fn protected_nv_cannot_be_written_without_qualified_unlock_state() {
+        let root = std::env::temp_dir().join(format!("rfs-protected-write-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        std::fs::create_dir_all(root.join("efs")).unwrap();
+        let path = root.join("efs/nv_protected.bin");
+        std::fs::write(&path, b"protected original").unwrap();
+        let device = root.with_extension("dev");
+        let mut rfs = Rfs::new(
+            File::create(&device).unwrap(),
+            Store::new(root.clone()),
+            false,
+        );
+        let body = [2u32, 0, 4, IO_WRITE]
+            .into_iter()
+            .flat_map(u32::to_le_bytes)
+            .collect::<Vec<_>>();
+        rfs.handle(&frame(RFS_IO_REQUEST, 7, &body));
+        assert_eq!(
+            std::fs::read(&device).unwrap(),
+            frame(
+                RFS_OP_STATUS,
+                7,
+                &[
+                    RFS_STATUS_INVALID_TRANSFER.to_le_bytes(),
+                    2u32.to_le_bytes()
+                ]
+                .concat()
+            )
+        );
+        assert_eq!(std::fs::read(&path).unwrap(), b"protected original");
+        assert!(!root.join("efs/nv_protected.bin.part").exists());
+        std::fs::remove_dir_all(root).unwrap();
+        std::fs::remove_file(device).unwrap();
+    }
