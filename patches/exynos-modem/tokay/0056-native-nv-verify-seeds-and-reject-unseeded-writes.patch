+    #[test]
+    fn a_bad_seed_checksum_blocks_both_nv_directions() {
+        let root = std::env::temp_dir().join(format!("rfs-bad-seed-{}", std::process::id()));
+        std::fs::create_dir_all(root.join("efs")).unwrap();
+        crate::store::write_test_fixture(root.join("efs/nv_normal.bin"), b"original").unwrap();
+        std::fs::write(
+            root.join("efs/nv_normal.bin.md5"),
+            b"00000000000000000000000000000000",
+        )
+        .unwrap();
+        for kind in [IO_READ, IO_WRITE] {
+            let device = root.join(format!("transport-{kind}"));
+            let mut rfs = Rfs::new(
+                File::create(&device).unwrap(),
+                Store::new(root.clone()),
+                false,
+            );
+            let body = [1u32, 0, 4, kind]
+                .into_iter()
+                .flat_map(u32::to_le_bytes)
+                .collect::<Vec<_>>();
+            rfs.handle(&frame(RFS_IO_REQUEST, 7, &body));
+            assert_eq!(
+                std::fs::read(device).unwrap(),
+                error_response(
+                    7,
+                    if kind == IO_WRITE {
+                        RFS_STATUS_WRITE_FAILED
+                    } else {
+                        RFS_STATUS_INVALID_TRANSFER
+                    }
+                )
+            );
+        }
+        assert_eq!(
+            std::fs::read(root.join("efs/nv_normal.bin")).unwrap(),
+            b"original"
+        );
+        assert!(!root.join("efs/nv_normal.bin.part").exists());
+        std::fs::remove_dir_all(root).unwrap();
+    }
