+/// Verify a legacy/native seed or the read-only vendor seed. A present but
+/// invalid file is an error, never permission to fall back to another copy.
+pub(super) fn read_seed(directory: &Path, name: &str) -> io::Result<Option<PathBuf>> {
+    if !known_name(name) {
+        return Err(invalid("unknown NV seed filename"));
+    }
+    let path = directory.join(name);
+    match fs::symlink_metadata(&path) {
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {
+            return match fs::symlink_metadata(directory.join(format!("{name}.md5"))) {
+                Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(None),
+                _ => Err(invalid(
+                    "NV seed data is missing but its sidecar is present or inaccessible",
+                )),
+            };
+        }
+        Err(error) => return Err(error),
+        Ok(_) => {}
+    }
+    if !fs::symlink_metadata(directory)?.is_dir() {
+        return Err(invalid("NV seed directory is not a real directory"));
+    }
+    let mut data = regular(&path)?;
+    if data.metadata()?.len() == 0 {
+        return Err(invalid("empty NV seed"));
+    }
+    let mut sidecar = regular(&directory.join(format!("{name}.md5")))?;
+    if sidecar.metadata()?.len() != 32 {
+        return Err(invalid("invalid NV seed checksum size"));
+    }
+    let mut expected = [0; 32];
+    sidecar.read_exact(&mut expected)?;
+    if !expected.iter().all(u8::is_ascii_hexdigit)
+        || !expected.eq_ignore_ascii_case(checksum(&mut data)?.as_bytes())
+    {
+        return Err(invalid("NV seed checksum mismatch"));
+    }
+    Ok(Some(path))
 }
 
