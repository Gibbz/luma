+    #[test]
+    fn absent_nv_seed_cannot_be_read_as_empty_or_bootstrap_a_write() {
+        for kind in [IO_READ, IO_WRITE] {
+            let root = std::env::temp_dir()
+                .join(format!("rfs-missing-seed-{}-{kind}", std::process::id()));
+            let device = root.with_extension("dev");
+            let mut rfs = Rfs::new(
+                File::create(&device).unwrap(),
+                Store::new(root.clone()),
+                false,
+            );
+            let body = [1u32, 0, 4, kind]
+                .into_iter()
+                .flat_map(u32::to_le_bytes)
+                .collect::<Vec<_>>();
+            rfs.handle(&frame(RFS_IO_REQUEST, 7, &body));
+            assert_eq!(
+                std::fs::read(&device).unwrap(),
+                error_response(
+                    7,
+                    if kind == IO_WRITE {
+                        RFS_STATUS_WRITE_FAILED
+                    } else {
+                        RFS_STATUS_INVALID_TRANSFER
+                    }
+                )
+            );
+            assert!(
+                !root.exists(),
+                "missing identity seed must not create writable NV state"
+            );
+            drop(rfs);
+            std::fs::remove_file(device).unwrap();
+        }
+    }
