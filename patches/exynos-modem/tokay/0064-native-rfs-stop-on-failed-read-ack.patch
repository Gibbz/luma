+    fn read_ack_fixture(label: &str) -> (PathBuf, PathBuf, Rfs) {
+        let root =
+            std::env::temp_dir().join(format!("rfs-read-ack-{}-{}", label, std::process::id()));
+        std::fs::create_dir_all(&root).unwrap();
+        let source = root.join("source");
+        crate::store::write_test_fixture(&source, &vec![0x31; CHUNK * 2 + 37]).unwrap();
+        let device = root.join("device");
+        let mut rfs = Rfs::new(
+            File::create(&device).unwrap(),
+            Store::new(root.clone()),
+            false,
+        );
+        rfs.files.insert(
+            40,
+            Fent {
+                fd: Some(File::open(&source).unwrap()),
+                token: 7,
+                rremain: (CHUNK * 2 + 37) as i64,
+                ..Fent::default()
+            },
+        );
+        rfs.read_step(40);
+        (root, device, rfs)
+    }
+
+    fn read_ack(status: u32) -> Vec<u8> {
+        // Factory dispatch does not require this token to equal the IO token.
+        frame(
+            RFS_READ,
+            19,
+            &[status.to_le_bytes(), 40u32.to_le_bytes()].concat(),
+        )
+    }
+
+    #[test]
+    fn failed_read_ack_stops_transfer_without_more_data_or_success() {
+        let (root, device, mut rfs) = read_ack_fixture("failed");
+        let before = std::fs::read(&device).unwrap();
+        rfs.handle(&read_ack(4));
+        assert_eq!(std::fs::read(&device).unwrap(), before);
+        assert_eq!(rfs.files[&40].rremain, 0);
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn failed_final_read_ack_does_not_claim_success() {
+        let (root, device, mut rfs) = read_ack_fixture("final");
+        rfs.handle(&read_ack(0));
+        rfs.handle(&read_ack(0));
+        assert_eq!(rfs.files[&40].rremain, 0);
+        let before = std::fs::read(&device).unwrap();
+        rfs.handle(&read_ack(6));
+        assert_eq!(std::fs::read(&device).unwrap(), before);
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn read_ack_after_cancellation_is_rejected_as_inactive() {
+        let (root, device, mut rfs) = read_ack_fixture("inactive");
+        rfs.handle(&read_ack(4));
+        let before = std::fs::read(&device).unwrap().len();
+        rfs.handle(&read_ack(0));
+        let after = std::fs::read(&device).unwrap();
+        assert_eq!(
+            &after[before..],
+            frame(
+                RFS_OP_STATUS,
+                19,
+                &[6u32.to_le_bytes(), 40u32.to_le_bytes()].concat()
+            )
+        );
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn new_read_request_recovers_after_peer_cancels_read() {
+        let (root, device, mut rfs) = read_ack_fixture("recover");
+        rfs.handle(&read_ack(4));
+        let before = std::fs::read(&device).unwrap().len();
+        rfs.handle(&frame(
+            RFS_IO_REQUEST,
+            21,
+            &[
+                40u32.to_le_bytes(),
+                0u32.to_le_bytes(),
+                3u32.to_le_bytes(),
+                IO_READ.to_le_bytes(),
+            ]
+            .concat(),
+        ));
+        let after = std::fs::read(&device).unwrap();
+        assert_eq!(
+            &after[before..],
+            frame(
+                RFS_READ,
+                21,
+                &[
+                    40u32.to_le_bytes().as_slice(),
+                    0u32.to_le_bytes().as_slice(),
+                    3u32.to_le_bytes().as_slice(),
+                    b"111"
+                ]
+                .concat()
+            )
+        );
+        rfs.handle(&read_ack(0));
+        assert!(std::fs::read(&device).unwrap().ends_with(&frame(
+            RFS_OP_STATUS,
+            21,
+            &[0u32.to_le_bytes(), 40u32.to_le_bytes(), 0u32.to_le_bytes()].concat()
+        )));
+        std::fs::remove_dir_all(root).unwrap();
+    }
