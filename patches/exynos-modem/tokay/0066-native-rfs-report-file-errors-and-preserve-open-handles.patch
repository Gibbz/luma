+    fn file_error_open(fid: u32, advertised: u32, path: &[u8]) -> Vec<u8> {
+        frame(
+            RFS_OPEN,
+            31,
+            &[
+                fid.to_le_bytes().as_slice(),
+                advertised.to_le_bytes().as_slice(),
+                path,
+            ]
+            .concat(),
+        )
+    }
+    fn file_error_reply(fid: u32, status: u32) -> Vec<u8> {
+        frame(
+            RFS_OP_STATUS,
+            31,
+            &[status.to_le_bytes(), fid.to_le_bytes()].concat(),
+        )
+    }
+    #[test]
+    fn file_error_missing_open_does_not_create_a_successful_empty_handle() {
+        let (root, device, mut rfs) = read_ack_fixture("missing-open");
+        rfs.carrier_roots = vec![root.clone()];
+        let path = b"/vendor/firmware/carrierconfig/missing";
+        let before = std::fs::read(&device).unwrap().len();
+        rfs.handle(&file_error_open(41, path.len() as u32, path));
+        assert_eq!(
+            &std::fs::read(&device).unwrap()[before..],
+            file_error_reply(41, 1)
+        );
+        assert!(!rfs.files.contains_key(&41));
+        std::fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn file_error_truncated_open_cannot_open_a_shorter_existing_path() {
+        let (root, device, mut rfs) = read_ack_fixture("truncated-open");
+        rfs.carrier_roots = vec![root.clone()];
+        let path = b"/vendor/firmware/carrierconfig/source";
+        let before = std::fs::read(&device).unwrap().len();
+        rfs.handle(&file_error_open(41, path.len() as u32 + 9, path));
+        assert_eq!(
+            &std::fs::read(&device).unwrap()[before..],
+            file_error_reply(41, 6)
+        );
+        assert!(!rfs.files.contains_key(&41));
+        std::fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn file_error_duplicate_open_preserves_an_active_handle() {
+        let (root, device, mut rfs) = read_ack_fixture("duplicate-open");
+        rfs.carrier_roots = vec![root.clone()];
+        let path = b"/vendor/firmware/carrierconfig/source";
+        let before = std::fs::read(&device).unwrap().len();
+        let remaining = rfs.files[&40].rremain;
+        rfs.handle(&file_error_open(40, path.len() as u32, path));
+        assert_eq!(
+            &std::fs::read(&device).unwrap()[before..],
+            file_error_reply(40, 6)
+        );
+        assert_eq!(rfs.files[&40].rremain, remaining);
+        assert!(rfs.files[&40].read_ack_pending);
+        std::fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn file_error_unknown_io_handle_is_not_reported_as_success() {
+        let (root, device, mut rfs) = read_ack_fixture("unknown-io");
+        let before = std::fs::read(&device).unwrap().len();
+        rfs.handle(&frame(
+            RFS_IO_REQUEST,
+            31,
+            &[
+                99u32.to_le_bytes(),
+                0u32.to_le_bytes(),
+                3u32.to_le_bytes(),
+                IO_READ.to_le_bytes(),
+            ]
+            .concat(),
+        ));
+        assert_eq!(
+            &std::fs::read(&device).unwrap()[before..],
+            file_error_reply(99, 6)
+        );
+        assert!(!rfs.files.contains_key(&99));
+        std::fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn file_error_read_failure_is_not_reported_as_success() {
+        let (root, device, mut rfs) = read_ack_fixture("read-error");
+        let before = std::fs::read(&device).unwrap().len();
+        let e = rfs.files.get_mut(&40).unwrap();
+        e.fd = Some(File::open(&root).unwrap());
+        e.token = 31; // read(2) on a directory returns EISDIR on Linux.
+        rfs.read_step(40);
+        assert_eq!(
+            &std::fs::read(&device).unwrap()[before..],
+            file_error_reply(40, 3)
+        );
+        assert!(!rfs.files[&40].read_ack_pending);
+        assert_eq!(rfs.files[&40].rremain, 0);
+        std::fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn file_error_handling_still_allows_a_real_empty_carrier_file() {
+        let (root, device, mut rfs) = read_ack_fixture("valid-empty");
+        rfs.carrier_roots = vec![root.clone()];
+        std::fs::write(root.join("empty"), b"").unwrap();
+        let path = b"/vendor/firmware/carrierconfig/empty";
+        let before = std::fs::read(&device).unwrap().len();
+        rfs.handle(&file_error_open(41, path.len() as u32, path));
+        assert_eq!(
+            &std::fs::read(&device).unwrap()[before..],
+            frame(
+                RFS_OP_STATUS,
+                31,
+                &[0u32.to_le_bytes(), 41u32.to_le_bytes(), 0u32.to_le_bytes()].concat()
+            )
+        );
+        assert!(rfs.files[&41].fd.is_some());
+        let before = std::fs::read(&device).unwrap().len();
+        rfs.handle(&frame(
+            RFS_IO_REQUEST,
+            31,
+            &[
+                41u32.to_le_bytes(),
+                0u32.to_le_bytes(),
+                1u32.to_le_bytes(),
+                IO_READ.to_le_bytes(),
+            ]
+            .concat(),
+        ));
+        assert_eq!(
+            &std::fs::read(&device).unwrap()[before..],
+            frame(
+                RFS_OP_STATUS,
+                31,
+                &[0u32.to_le_bytes(), 41u32.to_le_bytes(), 0u32.to_le_bytes()].concat()
+            )
+        );
+        assert!(!rfs.files[&41].read_ack_pending);
+        assert_eq!(rfs.files[&41].rremain, 0);
+        std::fs::remove_dir_all(root).unwrap();
+    }
