+    #[test]
+    fn stale_read_ack_success_cannot_advance_an_active_transfer() {
+        let (root, device, mut rfs) = read_ack_fixture("stale-success");
+        let before = std::fs::read(&device).unwrap().len();
+        let remain = rfs.files[&40].rremain;
+        rfs.handle(&frame(
+            RFS_READ,
+            19,
+            &[0u32.to_le_bytes(), 40u32.to_le_bytes()].concat(),
+        ));
+        let after = std::fs::read(&device).unwrap();
+        assert_eq!(
+            &after[before..],
+            frame(
+                RFS_OP_STATUS,
+                19,
+                &[6u32.to_le_bytes(), 40u32.to_le_bytes()].concat()
+            )
+        );
+        assert_eq!(rfs.files[&40].rremain, remain);
+        assert!(rfs.files[&40].read_ack_pending);
+        rfs.handle(&read_ack(0));
+        assert_eq!(rfs.files[&40].rremain, 37);
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn stale_read_ack_failure_cannot_cancel_an_active_transfer() {
+        let (root, device, mut rfs) = read_ack_fixture("stale-failure");
+        let before = std::fs::read(&device).unwrap().len();
+        let remain = rfs.files[&40].rremain;
+        rfs.handle(&frame(
+            RFS_READ,
+            19,
+            &[4u32.to_le_bytes(), 40u32.to_le_bytes()].concat(),
+        ));
+        assert_eq!(rfs.files[&40].rremain, remain);
+        assert!(rfs.files[&40].read_ack_pending);
+        assert_eq!(
+            &std::fs::read(&device).unwrap()[before..],
+            frame(
+                RFS_OP_STATUS,
+                19,
+                &[6u32.to_le_bytes(), 40u32.to_le_bytes()].concat()
+            )
+        );
+        rfs.handle(&read_ack(0));
+        assert_eq!(rfs.files[&40].rremain, 37);
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn stale_read_ack_final_cannot_complete_an_active_transfer() {
+        let (root, device, mut rfs) = read_ack_fixture("stale-final");
+        rfs.handle(&read_ack(0));
+        rfs.handle(&read_ack(0));
+        let before = std::fs::read(&device).unwrap().len();
+        rfs.handle(&frame(
+            RFS_READ,
+            19,
+            &[0u32.to_le_bytes(), 40u32.to_le_bytes()].concat(),
+        ));
+        assert_eq!(
+            &std::fs::read(&device).unwrap()[before..],
+            frame(
+                RFS_OP_STATUS,
+                19,
+                &[6u32.to_le_bytes(), 40u32.to_le_bytes()].concat()
+            )
+        );
+        assert!(rfs.files[&40].read_ack_pending);
+        rfs.handle(&read_ack(0));
+        assert!(std::fs::read(&device).unwrap().ends_with(&frame(
+            RFS_OP_STATUS,
+            7,
+            &[0u32.to_le_bytes(), 40u32.to_le_bytes(), 0u32.to_le_bytes()].concat()
+        )));
+        std::fs::remove_dir_all(root).unwrap();
+    }
