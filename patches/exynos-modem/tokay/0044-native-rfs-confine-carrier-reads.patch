+    #[test]
+    fn carrier_paths_are_confined_and_do_not_follow_symlinks() {
+        use std::os::unix::fs::symlink;
+        let root = std::env::temp_dir().join(format!("rfs-confined-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        let allowed = root.join("allowed");
+        std::fs::create_dir_all(allowed.join("nested")).unwrap();
+        std::fs::write(allowed.join("nested/config"), b"permitted").unwrap();
+        std::fs::write(root.join("secret"), b"outside").unwrap();
+        symlink(root.join("secret"), allowed.join("link")).unwrap();
+        symlink(&root, allowed.join("escape")).unwrap();
+        let fifo = CString::new(allowed.join("fifo").as_os_str().as_bytes()).unwrap();
+        assert_eq!(unsafe { libc::mkfifo(fifo.as_ptr(), 0o600) }, 0);
+        let roots = vec![allowed.clone()];
+        let mut valid = open_path("/vendor/firmware/carrierconfig/nested/config", &roots).unwrap();
+        let mut bytes = Vec::new();
+        valid.read_to_end(&mut bytes).unwrap();
+        assert_eq!(bytes, b"permitted");
+        for path in [
+            "/tmp/carrierconfig/secret",
+            "/etc/confpack",
+            "/etc/shadow",
+            "/vendor/firmware/carrierconfig-evil/secret",
+            "/vendor/firmware/carrierconfig/../secret",
+            "/vendor/firmware/carrierconfig/nested/../../secret",
+            "/vendor/firmware/carrierconfig/link",
+            "/vendor/firmware/carrierconfig/escape/secret",
+            "/vendor/firmware/carrierconfig/nested",
+            "/vendor/firmware/carrierconfig/fifo",
+            "/vendor/firmware/carrierconfig/",
+            "/vendor/firmware/carrierconfig/x\0y",
+        ] {
+            assert!(open_path(path, &roots).is_none(), "accepted {path:?}");
+        }
+        let alias = root.join("root-link");
+        symlink(&allowed, &alias).unwrap();
+        assert!(open_path("/vendor/firmware/carrierconfig/nested/config", &[alias]).is_none());
+        std::fs::remove_dir_all(&root).unwrap();
+    }
