-        return File::open(format!("/carrierconfig{}", rest)).ok();
+/// Read only regular files beneath the explicitly provisioned carrier roots.
+/// CP paths name the factory namespace; roots are selected by us, never the CP.
+fn open_path(path: &str, roots: &[PathBuf]) -> Option<File> {
+    let relative = path.strip_prefix("/vendor/firmware/carrierconfig/")?;
+    let names: Vec<CString> = Path::new(relative)
+        .components()
+        .map(|component| match component {
+            Component::Normal(name) => CString::new(name.as_bytes()).ok(),
+            _ => None,
+        })
+        .collect::<Option<_>>()?;
+    let (last, parents) = names.split_last()?;
+    for root in roots {
+        let attempt = || -> Option<File> {
+            let mut directory = OpenOptions::new()
+                .read(true)
+                .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)
+                .open(root)
+                .ok()?;
+            for name in parents {
+                let fd = unsafe {
+                    libc::openat(
+                        directory.as_raw_fd(),
+                        name.as_ptr(),
+                        libc::O_RDONLY | libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+                    )
+                };
+                if fd < 0 {
+                    return None;
+                }
+                directory = unsafe { File::from_raw_fd(fd) };
+            }
+            // NONBLOCK prevents a misplaced FIFO from stalling the RFS worker.
+            let fd = unsafe {
+                libc::openat(
+                    directory.as_raw_fd(),
+                    last.as_ptr(),
+                    libc::O_RDONLY | libc::O_NOFOLLOW | libc::O_CLOEXEC | libc::O_NONBLOCK,
+                )
+            };
+            if fd < 0 {
+                return None;
+            }
+            let file = unsafe { File::from_raw_fd(fd) };
+            file.metadata().ok()?.is_file().then_some(file)
+        };
+        if let Some(file) = attempt() {
+            return Some(file);
+        }
     }
     None
 }
