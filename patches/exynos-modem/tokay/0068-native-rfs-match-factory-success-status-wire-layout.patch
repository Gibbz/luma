+    // Golden records independently recovered from CP41 rfsd stores at
+    // 0xb420..0xb458 (OPEN) and 0xae18..0xae48 (ordinary success).
+    const FACTORY_SUCCESS_WIRE: [u8; 16] = [3, 0, 0x34, 0x12, 8, 0, 0, 0, 0, 0, 0, 0, 40, 0, 0, 0];
+    const FACTORY_OPEN_WIRE: [u8; 20] = [
+        3, 0, 0x34, 0x12, 8, 0, 0, 0, 0, 0, 0, 0, 40, 0, 0, 0, 1, 8, 0, 0,
+    ];
+    #[test]
+    fn factory_status_wire_read_completion_has_no_size_extension() {
+        let (root, device, mut rfs) = read_ack_fixture("wire-read");
+        let e = rfs.files.get_mut(&40).unwrap();
+        e.token = 0x1234;
+        e.rremain = 0;
+        let before = std::fs::read(&device).unwrap().len();
+        rfs.handle(&frame(
+            RFS_READ,
+            0x1234,
+            &[0u32.to_le_bytes(), 40u32.to_le_bytes()].concat(),
+        ));
+        assert_eq!(
+            &std::fs::read(&device).unwrap()[before..],
+            FACTORY_SUCCESS_WIRE
+        );
+        std::fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn factory_status_wire_open_uses_factory_declared_length_and_extension() {
+        let (root, device, mut rfs) = read_ack_fixture("wire-open");
+        rfs.files.remove(&40);
+        rfs.carrier_roots = vec![root.clone()];
+        std::fs::write(root.join("golden"), vec![0x31; 2049]).unwrap();
+        let path = b"/vendor/firmware/carrierconfig/golden";
+        let before = std::fs::read(&device).unwrap().len();
+        rfs.handle(&frame(
+            RFS_OPEN,
+            0x1234,
+            &[
+                40u32.to_le_bytes().as_slice(),
+                (path.len() as u32).to_le_bytes().as_slice(),
+                path,
+            ]
+            .concat(),
+        ));
+        assert_eq!(
+            &std::fs::read(&device).unwrap()[before..],
+            FACTORY_OPEN_WIRE
+        );
+        std::fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn factory_status_wire_close_has_no_size_extension() {
+        let (root, device, mut rfs) = read_ack_fixture("wire-close");
+        let e = rfs.files.get_mut(&40).unwrap();
+        e.read_ack_pending = false;
+        e.rremain = 0;
+        let before = std::fs::read(&device).unwrap().len();
+        rfs.handle(&frame(RFS_CLOSE, 0x1234, &40u32.to_le_bytes()));
+        assert_eq!(
+            &std::fs::read(&device).unwrap()[before..],
+            FACTORY_SUCCESS_WIRE
+        );
+        assert!(!rfs.files.contains_key(&40));
+        std::fs::remove_dir_all(root).unwrap();
+    }
