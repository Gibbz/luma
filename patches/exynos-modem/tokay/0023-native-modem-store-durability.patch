+    #[test]
+    fn missing_stage_preserves_committed_state() {
+        let root = tmp("missing-stage");
+        let s = Store::new(root.clone());
+        fs::create_dir_all(root.join("efs")).unwrap();
+        fs::write(s.own(Kind::Efs, "nv_normal.bin"), b"original").unwrap();
+        assert!(s.commit(Kind::Efs, "nv_normal.bin").is_err());
+        assert_eq!(
+            fs::read(s.own(Kind::Efs, "nv_normal.bin")).unwrap(),
+            b"original"
+        );
+        fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn symlink_stage_preserves_committed_state_and_target() {
+        let root = tmp("symlink-stage");
+        let s = Store::new(root.clone());
+        fs::create_dir_all(root.join("efs")).unwrap();
+        fs::write(s.own(Kind::Efs, "nv_normal.bin"), b"original").unwrap();
+        let target = root.join("other");
+        fs::write(&target, b"untouched").unwrap();
+        std::os::unix::fs::symlink(&target, s.part(Kind::Efs, "nv_normal.bin").unwrap()).unwrap();
+        assert!(s.commit(Kind::Efs, "nv_normal.bin").is_err());
+        assert_eq!(
+            fs::read(s.own(Kind::Efs, "nv_normal.bin")).unwrap(),
+            b"original"
+        );
+        assert_eq!(fs::read(target).unwrap(), b"untouched");
+        fs::remove_dir_all(root).unwrap();
+    }
