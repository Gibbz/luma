+    #[test]
+    fn newly_created_state_ancestors_are_private() {
+        let root = tmp("durable-private");
+        let store = Store::new(root.join("nested/state"));
+        let stage = store.part(Kind::Efs, "nv_normal.bin").unwrap();
+        assert_eq!(stage, root.join("nested/state/efs/nv_normal.bin.part"));
+        for path in [
+            &root,
+            &root.join("nested"),
+            &root.join("nested/state"),
+            &root.join("nested/state/efs"),
+        ] {
+            assert_eq!(fs::symlink_metadata(path).unwrap().mode() & 0o777, 0o700);
+        }
+        fs::write(&stage, b"complete").unwrap();
+        let path = store.commit(Kind::Efs, "nv_normal.bin").unwrap();
+        assert_eq!(fs::read(path).unwrap(), b"complete");
+        fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn state_subdirectory_symlink_is_rejected() {
+        let root = tmp("dir-link");
+        fs::create_dir_all(root.join("outside")).unwrap();
+        std::os::unix::fs::symlink(root.join("outside"), root.join("efs")).unwrap();
+        let store = Store::new(root.clone());
+        assert!(store.part(Kind::Efs, "nv_normal.bin").is_err());
+        assert_eq!(fs::read_dir(root.join("outside")).unwrap().count(), 0);
+        fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn writable_shared_state_root_is_rejected_without_chmod() {
+        use std::os::unix::fs::PermissionsExt;
+        let root = tmp("shared-root");
+        fs::create_dir_all(&root).unwrap();
+        fs::set_permissions(&root, fs::Permissions::from_mode(0o777)).unwrap();
+        let store = Store::new(root.clone());
+        assert!(store.part(Kind::Efs, "nv_normal.bin").is_err());
+        assert_eq!(fs::symlink_metadata(&root).unwrap().mode() & 0o777, 0o777);
+        assert!(!root.join("efs").exists());
+        fs::remove_dir_all(root).unwrap();
+    }
