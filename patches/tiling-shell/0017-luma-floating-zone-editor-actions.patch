--- a/indicator/editorActions.js
+++ b/indicator/editorActions.js
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+import { St, Clutter, Gio } from "../gi/ext.js";
+import * as Main from "resource:///org/gnome/shell/ui/main.js";
+import { registerGObjectClass } from "../utils/gjs.js";
+import { _ } from "../translations.js";
+
+// Independent of the optional panel indicator and the editor's tile actors.
+// Top chrome keeps these controls above zones, split lines and window previews.
+const _EditorActions = class _EditorActions extends St.BoxLayout {
+  _appearance = null;
+  constructor(indicator) {
+    super({ style_class: "luma-tiling-editor-actions", reactive: true });
+    const close = new St.Button({
+      label: _("Close"), accessible_name: _("Close without saving"),
+      style_class: "button luma-tiling-editor-action",
+      can_focus: true, reactive: true, track_hover: true
+    });
+    const save = new St.Button({
+      label: _("Save"), accessible_name: _("Save layout"),
+      style_class: "button luma-tiling-editor-action default",
+      can_focus: true, reactive: true, track_hover: true
+    });
+    close.connect("clicked", () => indicator.cancelLayoutOnClick());
+    save.connect("clicked", () => indicator.saveLayoutOnClick());
+    this.add_child(close);
+    this.add_child(save);
+    const schema = Gio.SettingsSchemaSource.get_default()?.lookup(
+      "org.project_luma.shell-state", true);
+    if (schema) {
+      this._appearance = new Gio.Settings({ settings_schema: schema });
+      this._appearance.connectObject("changed::surface-treatment",
+        () => this._syncAppearance(), this);
+    }
+    this._syncAppearance();
+    Main.layoutManager.addTopChrome(this, { affectsStruts: false });
+    this.connect("notify::width", () => this._place());
+    global.display.connectObject("workareas-changed", () => this._place(), this);
+    // The tile canvas has fixed monitor geometry. End an unsaved edit instead
+    // of leaving stale tiles and an unreachable toolbar after a hotplug.
+    Main.layoutManager.connectObject("monitors-changed",
+      () => indicator.cancelLayoutOnClick(), this);
+    this.connect("destroy", () => {
+      this._appearance?.disconnectObject(this);
+      this._appearance = null;
+      global.display.disconnectObject(this);
+      Main.layoutManager.disconnectObject(this);
+    });
+    this._place();
+  }
+
+  _syncAppearance() {
+    const mode = this._appearance?.get_string("surface-treatment") || "dark";
+    for (const name of ["light", "dark", "frost", "glass"])
+      if (name === mode) this.add_style_class_name(`luma-surface-${name}`);
+      else this.remove_style_class_name(`luma-surface-${name}`);
+  }
+
+  _place() {
+    const area = Main.layoutManager.getWorkAreaForMonitor(Main.layoutManager.primaryIndex);
+    const margin = 16 * St.ThemeContext.get_for_stage(global.stage).scale_factor;
+    this.set_position(Math.max(area.x, area.x + area.width - this.width - margin),
+      area.y + margin);
+  }
+};
+registerGObjectClass(_EditorActions);
+export default _EditorActions;
