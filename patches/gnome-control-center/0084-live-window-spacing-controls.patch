+static char *windows_structure (View *v)
+{
+  const char *keys[] = { "tile", "edgeTile", "resizeTogether", "windowBorder", "hot", "edges", "ws", "wsMon", "swi" };
+  GString *signature = g_string_new (NULL);
+  for (guint i = 0; i < G_N_ELEMENTS (keys); i++)
+    {
+      JsonNode *node = cc_luma_fixture_get (v->model, keys[i]);
+      g_autofree char *value = node ? json_to_string (node, FALSE) : g_strdup ("null");
+      g_string_append_printf (signature, "%s:%s;", keys[i], value);
+    }
+  return g_string_free (signature, FALSE);
+}
+static GtkWidget *windows_range (GtkWidget *widget, const char *name)
+{
+  if (g_strcmp0 (gtk_widget_get_name (widget), name) == 0) return widget;
+  for (GtkWidget *child = gtk_widget_get_first_child (widget); child; child = gtk_widget_get_next_sibling (child))
+    {
+      GtkWidget *found = windows_range (child, name);
+      if (found) return found;
+    }
+  return NULL;
+}
+gboolean cc_luma_view_windows_sync (View *v)
+{
+  g_autofree char *signature = windows_structure (v);
+  if (g_strcmp0 (signature, g_object_get_data (G_OBJECT (v->root), "cf-windows-structure"))) return FALSE;
+  const char *keys[] = { "gap", "windowBorderSize", "wsN" };
+  for (guint i = 0; i < G_N_ELEMENTS (keys); i++)
+    {
+      g_autofree char *name = g_strconcat ("cf-", keys[i], NULL);
+      GtkWidget *range = windows_range (v->root, name);
+      JsonNode *node = cc_luma_fixture_get (v->model, keys[i]);
+      if (!GTK_IS_RANGE (range) || !node) continue;
+      gint64 value = json_node_get_int (node);
