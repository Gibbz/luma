+typedef struct { JsonObject *device; guint order; gboolean unnamed; } DiscoveryRow;
+static gboolean unnamed_device (JsonObject *device)
+{
+  const char *name = json_object_get_string_member_with_default (device, "n", "");
+  const char *id = json_object_get_string_member (device, "id");
+  if (!*name || g_ascii_strcasecmp (name, id) == 0) return TRUE;
+  guint digits = 0;
+  for (const char *p = name; *p; p++)
+    {
+      if (g_ascii_isxdigit (*p)) digits++;
+      else if (*p != ':' && *p != '-' && *p != ' ') return FALSE;
+    }
+  return digits >= 8;
+}
+static gint discovery_compare (gconstpointer left, gconstpointer right)
+{
+  const DiscoveryRow *a = *(DiscoveryRow * const *) left, *b = *(DiscoveryRow * const *) right;
+  if (a->unnamed != b->unnamed) return a->unnamed ? 1 : -1;
+  return (a->order > b->order) - (a->order < b->order);
+}
+static void discovery_filter (GtkSearchEntry *entry, GtkWidget *root)
+{
+  GtkWidget *list = g_object_get_data (G_OBJECT (root), "cf-bt-discovery-list");
+  if (!list) return;
+  g_autofree char *query = g_utf8_casefold (gtk_editable_get_text (GTK_EDITABLE (entry)), -1);
+  guint matches = 0;
+  for (GtkWidget *row = gtk_widget_get_first_child (list); row; row = gtk_widget_get_next_sibling (row))
+    {
+      const char *terms = g_object_get_data (G_OBJECT (row), "cf-bt-search-terms");
+      if (!terms) continue;
+      gboolean visible = !*query || strstr (terms, query) != NULL;
+      gtk_widget_set_visible (row, visible);
+      matches += visible;
+    }
+  GtkWidget *empty = g_object_get_data (G_OBJECT (root), "cf-bt-search-empty");
+  if (empty) gtk_widget_set_visible (empty, *query && matches == 0);
+}
+static GtkWidget *discovery_search (View *v)
+{
+  GtkWidget *search = g_object_get_data (G_OBJECT (v->root), "cf-bt-search");
+  if (!search)
