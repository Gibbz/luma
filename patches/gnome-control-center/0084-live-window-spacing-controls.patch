+      g_object_set_data_full (G_OBJECT (v->root), "cf-bt-search", g_object_ref_sink (search), g_object_unref);
+      g_signal_connect_object (search, "search-changed", G_CALLBACK (discovery_filter), v->root, 0);
+    }
+  GtkWidget *parent = gtk_widget_get_parent (search);
+  if (GTK_IS_BOX (parent)) gtk_box_remove (GTK_BOX (parent), search);
+  return search;
+}
