+/*
+ * CONN MTCMOS, used when the consys device has no power domain attached.
+ * Same sequence and bus protection steps as the vendor MT6878 scpsys data
+ * (SPM PWR_CON 0x1c001e04, infracfg_ao bus protection).
+ */
+#define MT6878_SPM_BASE			0x1c001000
+#define MT6878_SPM_CONN_PWR_CON		0xe04
+#define MT6878_IFRAO_BASE		0x10001000
+#define MT6878_PWR_RST_B		BIT(0)
+#define MT6878_PWR_ISO			BIT(1)
+#define MT6878_PWR_ON			BIT(2)
+#define MT6878_PWR_ON_2ND		BIT(3)
+#define MT6878_PWR_CLK_DIS		BIT(4)
+#define MT6878_PWR_ACK			BIT(30)
+#define MT6878_PWR_ACK_2ND		BIT(31)
+
+static const struct {
+	u16 set, clr, sta;
+	u32 mask;
+} mt6878_conn_bp[] = {
+	{ 0x0c94, 0x0c98, 0x0c9c, BIT(1) },
+	{ 0x0c54, 0x0c58, 0x0c5c, BIT(12) },
+	{ 0x0c94, 0x0c98, 0x0c9c, BIT(0) },
+	{ 0x0c44, 0x0c48, 0x0c4c, BIT(8) },
+};
+
+static int mt6878_conn_mtcmos(bool on)
+{
+	void __iomem *spm, *ifr, *ctl;
+	u32 val;
+	int i, ret = 0;
+
+	spm = ioremap(MT6878_SPM_BASE, 0x1000);
+	ifr = ioremap(MT6878_IFRAO_BASE, 0x1000);
+	if (!spm || !ifr) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	ctl = spm + MT6878_SPM_CONN_PWR_CON;
+
+	if (on) {
+		val = readl(ctl) | MT6878_PWR_ON;
+		writel(val, ctl);
+		ret = readl_poll_timeout_atomic(ctl, val, val & MT6878_PWR_ACK, 10, 10000);
+		if (ret)
+			goto out;
+		udelay(50);
+		val |= MT6878_PWR_ON_2ND;
+		writel(val, ctl);
+		ret = readl_poll_timeout_atomic(ctl, val, val & MT6878_PWR_ACK_2ND, 10, 10000);
+		if (ret)
+			goto out;
+		val &= ~MT6878_PWR_CLK_DIS;
+		writel(val, ctl);
+		val &= ~MT6878_PWR_ISO;
+		writel(val, ctl);
+		val |= MT6878_PWR_RST_B;
+		writel(val, ctl);
+		for (i = ARRAY_SIZE(mt6878_conn_bp) - 1; i >= 0; i--)
+			writel(mt6878_conn_bp[i].mask, ifr + mt6878_conn_bp[i].clr);
+	} else {
+		for (i = 0; i < ARRAY_SIZE(mt6878_conn_bp); i++) {
+			writel(mt6878_conn_bp[i].mask, ifr + mt6878_conn_bp[i].set);
+			ret = readl_poll_timeout_atomic(ifr + mt6878_conn_bp[i].sta, val,
+				(val & mt6878_conn_bp[i].mask) == mt6878_conn_bp[i].mask, 10, 10000);
+			if (ret)
+				goto out;
+		}
+		val = readl(ctl) | MT6878_PWR_ISO;
+		writel(val, ctl);
+		val |= MT6878_PWR_CLK_DIS;
+		writel(val, ctl);
+		val &= ~MT6878_PWR_RST_B;
+		writel(val, ctl);
+		val &= ~MT6878_PWR_ON_2ND;
+		writel(val, ctl);
+		val &= ~MT6878_PWR_ON;
+		writel(val, ctl);
+		ret = readl_poll_timeout_atomic(ctl, val,
+			!(val & (MT6878_PWR_ACK | MT6878_PWR_ACK_2ND)), 10, 10000);
+	}
+out:
+	pr_info("[%s] %s ret=%d pwr_con=0x%08x\n", __func__, on ? "on" : "off", ret,
+		spm ? readl(spm + MT6878_SPM_CONN_PWR_CON) : 0);
+	if (ifr)
+		iounmap(ifr);
+	if (spm)
+		iounmap(spm);
+	return ret;
+}
+
