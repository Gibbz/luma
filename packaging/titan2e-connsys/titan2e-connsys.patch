+/* SPDX-License-Identifier: GPL-2.0 */
+/* Force-included into the MediaTek connectivity modules: 6.1 -> 7.2 API shims. */
+#ifndef __LUMA_CONNSYS_COMPAT_H
+#define __LUMA_CONNSYS_COMPAT_H
+#include <linux/string.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
