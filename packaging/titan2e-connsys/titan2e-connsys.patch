+#include <linux/sched/clock.h>
+#include <linux/rtc.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/device.h>
+#include <linux/device/class.h>
+#include <linux/pm_wakeup.h>
+
+/* class_create() lost its owner argument in 6.4 */
+#define __luma_class_create(owner, name) class_create(name)
+#define class_create(...) __luma_cc_pick(__VA_ARGS__, __luma_class_create, __luma_class_create1)(__VA_ARGS__)
+#define __luma_cc_pick(_1, _2, NAME, ...) NAME
+#define __luma_class_create1(name) (class_create)(name)
+
+/* strncpy() was removed from the kernel */
+static inline char *__luma_strncpy(char *d, const char *s, size_t n)
+{
+	size_t l = strnlen(s, n);
+
+	memcpy(d, s, l);
+	if (l < n)
+		memset(d + l, 0, n - l);
+	return d;
+}
+#define strncpy(d, s, n) __luma_strncpy(d, s, n)
+#include <linux/timer.h>
+#ifndef del_timer
+#define del_timer(t) timer_delete(t)
+#endif
+#ifndef del_timer_sync
+#define del_timer_sync(t) timer_delete_sync(t)
+#endif
+#ifndef from_timer
+#define from_timer(var, t, field) timer_container_of(var, t, field)
+#endif
+#include "luma-sip.h"
+/* alarm_start{,_relative}() became alarm_start_timer(); handlers return void */
+#define alarm_start_relative(a, t) alarm_start_timer(a, t, true)
+#define alarm_start(a, t) alarm_start_timer(a, t, false)
+/* strlcpy() was removed from the kernel */
+static inline size_t __luma_strlcpy(char *d, const char *s, size_t n)
+{
+	size_t l = strlen(s);
+
+	if (n) {
+		size_t c = l >= n ? n - 1 : l;
+
+		memcpy(d, s, c);
+		d[c] = '\0';
+	}
+	return l;
+}
+#define strlcpy(d, s, n) __luma_strlcpy(d, s, n)
+/* gen4m carries its own wpa_supplicant crypto; keep it apart from <crypto/sha2.h> */
+#include <crypto/sha2.h>
+#include <crypto/sha1.h>
+#define hmac_sha256 wpa_hmac_sha256
+#define hmac_sha384 wpa_hmac_sha384
+#define hmac_sha512 wpa_hmac_sha512
+#define sha384_init wpa_sha384_init
+#define sha512_init wpa_sha512_init
+#define sha256_init wpa_sha256_init
+#define hmac_sha1 wpa_hmac_sha1
+#define hmac_sha1_vector wpa_hmac_sha1_vector
+#include <linux/netdevice.h>
+#include <net/netdev_rx_queue.h>
+#include <net/rps.h>
+/* sched_setscheduler() is no longer exported to modules */
+#include <linux/sched.h>
+#include <uapi/linux/sched/types.h>
+static inline int __luma_sched_setscheduler(struct task_struct *p, int policy,
+					    const struct sched_param *param)
+{
+	if (policy == SCHED_FIFO || policy == SCHED_RR)
+		sched_set_fifo(p);
+	else
+		sched_set_normal(p, 0);
+	return 0;
+}
+#define sched_setscheduler(p, pol, prm) __luma_sched_setscheduler(p, pol, prm)
+#endif
