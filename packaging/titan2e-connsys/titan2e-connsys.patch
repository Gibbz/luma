 {
 	int ret = 0;
@@ -131,6 +223,8 @@ int consys_platform_spm_conn_ctrl_mt6878(unsigned int enable)
 	}
 
 	if (enable) {
+		if (!pdev->dev.pm_domain)
+			mt6878_conn_mtcmos(true);
 		ret = pm_runtime_get_sync(&(pdev->dev));
 		if (ret)
 			pr_info("pm_runtime_get_sync() fail(%d)\n", ret);
@@ -154,6 +248,8 @@ int consys_platform_spm_conn_ctrl_mt6878(unsigned int enable)
 			pr_info("pm_runtime_put_sync() fail.\n");
 		else
 			pr_info("pm_runtime_put_sync() CONSYS ok\n");
+		if (!pdev->dev.pm_domain)
+			mt6878_conn_mtcmos(false);
 	}
 	return ret;
 }
