+static char *wifi_dma_pool = "";
+module_param(wifi_dma_pool, charp, 0444);
+MODULE_PARM_DESC(wifi_dma_pool, "reserved-memory node for the Wi-Fi DMA pool (bring-up override)");
+
+/*
+ * Bring-up: use the named carve-out as the Wi-Fi DMA pool even when the
+ * running DT does not mark it as a shared-dma-pool. The ops come from any
+ * shared-dma-pool node; the pool itself is created on first device_init.
+ */
+static void axiUseWifiPoolOverride(struct platform_device *pdev)
+{
+	struct device_node *rmem_np, *pool, *np;
+	struct reserved_mem *rmem, *ref = NULL;
+	struct property *prop;
+	__be32 *val;
+
+	if (!wifi_dma_pool || !*wifi_dma_pool)
+		return;
+	pool = of_find_node_by_path(wifi_dma_pool);
+	if (!pool)
+		return;
+	rmem = of_reserved_mem_lookup(pool);
+	rmem_np = of_find_node_by_path("/reserved-memory");
+	for_each_child_of_node(rmem_np, np) {
+		struct reserved_mem *r;
+
+		if (!of_device_is_compatible(np, "shared-dma-pool"))
+			continue;
+		r = of_reserved_mem_lookup(np);
+		if (r && r->ops) {
+			ref = r;
+			of_node_put(np);
+			break;
+		}
+	}
+	of_node_put(rmem_np);
+	if (!rmem || !ref) {
+		of_node_put(pool);
+		return;
+	}
+	if (!rmem->ops)
+		rmem->ops = ref->ops;
+	if (!pool->phandle)
+		pool->phandle = 0x7e100043;
+	prop = kzalloc(sizeof(*prop) + sizeof(*val), GFP_KERNEL);
+	if (prop) {
+		val = (__be32 *)(prop + 1);
+		*val = cpu_to_be32(pool->phandle);
+		prop->name = "memory-region";
+		prop->length = sizeof(*val);
+		prop->value = val;
+		of_remove_property(pdev->dev.of_node,
+			of_find_property(pdev->dev.of_node, "memory-region", NULL));
+		if (of_add_property(pdev->dev.of_node, prop))
+			kfree(prop);
+		else
+			DBGLOG(INIT, INFO, "Wi-Fi DMA pool: %pOF %pa\n", pool, &rmem->base);
+	}
+	of_node_put(pool);
+}
