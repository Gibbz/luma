+/*
+ * The MT6685 clock buffer PMIC (SPMI usid 9) has no device of its own here:
+ * add one on the controller of the MT6363 referenced by the consys node.
+ */
+static struct spmi_device *g_spmi_mt6685;
+
+static struct regmap *clock_mng_spmi_mt6685(void)
+{
+	static const struct regmap_config cfg = {
+		.reg_bits = 16, .val_bits = 8, .max_register = 0xffff, .fast_io = true,
+	};
+	struct platform_device *pdev = get_consys_device();
+	struct spmi_device *ref, *sdev;
+	struct device_node *np;
+	struct regmap *map;
+
+	if (!pdev)
+		return NULL;
+	np = of_parse_phandle(pdev->dev.of_node, "mediatek,mt6363", 0);
+	if (!np)
+		return NULL;
+	ref = spmi_find_device_by_of_node(np);
+	of_node_put(np);
+	if (!ref)
+		return NULL;
+	sdev = spmi_device_alloc(ref->ctrl);
+	put_device(&ref->dev);
+	if (!sdev)
+		return NULL;
+	sdev->usid = 9;
+	if (spmi_device_add(sdev)) {
+		put_device(&sdev->dev);
+		return NULL;
+	}
+	map = regmap_init_spmi_ext(sdev, &cfg);
+	if (IS_ERR(map)) {
+		spmi_device_remove(sdev);
+		return NULL;
+	}
+	g_spmi_mt6685 = sdev;
+	pr_info("[%s] MT6685 regmap on usid 9\n", __func__);
+	return map;
+}
+
 struct regmap* consys_clock_mng_get_regmap(void)
 {
+	if (!g_regmap_mt6685)
+		g_regmap_mt6685 = clock_mng_spmi_mt6685();
 	return g_regmap_mt6685;
 }
 
