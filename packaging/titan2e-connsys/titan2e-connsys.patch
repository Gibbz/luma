index ecbcb76..2f4e73b 100644
--- a/bt/mt66xx/btmtk_main.c
+++ b/bt/mt66xx/btmtk_main.c
@@ -3497,6 +3497,24 @@ exit:
 	return ret;
 }
 
+/*
+ * The BD address lives in the phone's NVRAM (BT_Addr) and is written by the
+ * Android HAL. On Linux, userspace sets it through mgmt (btmgmt public-addr),
+ * which ends up here: MediaTek vendor command 0xfc1a.
+ */
+static int bt_set_bdaddr(struct hci_dev *hdev, const bdaddr_t *bdaddr)
+{
+	struct sk_buff *skb;
+
+	skb = __hci_cmd_sync(hdev, 0xfc1a, sizeof(bdaddr_t), bdaddr, HCI_INIT_TIMEOUT);
+	if (IS_ERR(skb)) {
+		BTMTK_ERR("%s: set bdaddr failed (%ld)", __func__, PTR_ERR(skb));
+		return PTR_ERR(skb);
+	}
+	kfree_skb(skb);
+	return 0;
+}
+
 static int bt_setup(struct hci_dev *hdev)
 {
 	int ret = 0;
@@ -3737,8 +3755,6 @@ int btmtk_allocate_hci_device(struct btmtk_dev *bdev, int hci_bus_type)
 	hdev->bus = hci_bus_type;
 	hci_set_drvdata(hdev, bdev);
 
-	/* HCI_PRIMARY = 0x00 */
-	hdev->dev_type = 0x00;
 
 	bdev->hdev = hdev;
 
@@ -3748,6 +3764,11 @@ int btmtk_allocate_hci_device(struct btmtk_dev *bdev, int hci_bus_type)
 	hdev->flush    = bt_flush;
 	hdev->send	   = bt_send_frame;
 	hdev->setup    = bt_setup;
+	hdev->set_bdaddr = bt_set_bdaddr;
+	/* no address until userspace sets one: register as unconfigured */
+	hci_set_quirk(hdev, HCI_QUIRK_INVALID_BDADDR);
+	/* the firmware rejects HCI Read Sync Train Params (0x0c77) */
+	hci_set_quirk(hdev, HCI_QUIRK_BROKEN_LOCAL_EXT_FEATURES_PAGE_2);
 
 	init_waitqueue_head(&bdev->p_wait_event_q);
 
