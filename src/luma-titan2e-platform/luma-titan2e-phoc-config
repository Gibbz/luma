#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Write /etc/phosh/phoc.ini (which phosh-session prefers) as Luma's phoc.ini
# with the Titan 2 Elite's output section, so the base file stays current.
set -eu
base=/opt/luma/phosh/share/phosh/phoc.ini
device=/usr/share/luma-titan2e/phoc-titan2e.ini
out=/etc/phosh/phoc.ini
[ -r "$base" ] && [ -r "$device" ] || exit 0
mkdir -p /etc/phosh
tmp=$(mktemp /etc/phosh/.phoc.ini.XXXXXX)
{
  echo "# Generated by luma-titan2e-platform from $base; local changes are replaced."
  # Drop any DSI-1 section of the base file; the device section replaces it.
  awk '/^\[/ { skip = ($0 == "[output:DSI-1]") } !skip { print }' "$base"
  echo
  cat "$device"
} >"$tmp"
chmod 0644 "$tmp"
mv -f "$tmp" "$out"
