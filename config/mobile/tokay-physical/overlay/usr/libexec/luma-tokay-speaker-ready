#!/usr/bin/python3
# SPDX-License-Identifier: Apache-2.0
from pathlib import Path
import json,stat
p=Path('/run/luma-tokay-audio/speaker-calibration.json')
parent=p.parent.lstat()
assert stat.S_ISDIR(parent.st_mode) and parent.st_uid==0 and not parent.st_mode&0o022
s=p.lstat()
assert stat.S_ISREG(s.st_mode) and s.st_uid==0 and not s.st_mode&0o022
report=json.loads(p.read_text())
assert report['both_unit_calibrations_selected'] is True
assert report['protection_errors'] is False
